self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
text := import("text")
maps := import("@platforma-sdk/workflow-tengo:maps")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pt := import("@platforma-sdk/workflow-tengo:pt")
units := import("@platforma-sdk/workflow-tengo:units")
qcReportColumns := import(":qc-report-columns")
memf := import(":mem-formula")

json := import("json")

self.defineOutputs("qcReportTable")

mixcrSw := assets.importSoftware("@platforma-open/milaboratories.software-mixcr:memory-from-limits")
ptablerSw := assets.importSoftware("@platforma-open/milaboratories.software-ptabler:main")

// The one-row-per-sample counting runs leave memory to the SDK, which sizes each run from
// the blob size of that sample's TSVs, with this floor. The bulk counts stream, but the
// single-cell pairing statistics group by cellKey and join, which polars runs in memory.
PER_SAMPLE_COUNTS_MEM_FLOOR_GIB := 8
PER_SAMPLE_COUNTS_CPU := 2

self.body(func(inputs) {
    clnsData := inputs.clnsData
    presetSpecForBack := inputs.presetSpecForBack
    sampleIdAxisSpec := inputs.sampleIdAxisSpec
    chains := inputs.chains
    library := inputs.library
    isLibraryFileGzipped := inputs.isLibraryFileGzipped
    clonotypeTablesData := inputs.clonotypeTablesData
	stopCodonTypes := inputs.stopCodonTypes
	stopCodonReplacements := inputs.stopCodonReplacements

    isSingleCell := len(presetSpecForBack.cellTags) > 0
    umiTags := presetSpecForBack.umiTags
	hasUmi := !is_undefined(umiTags) && len(umiTags) > 0
    cellTags := presetSpecForBack.cellTags
    hasAssembleCells := false
    for stage in presetSpecForBack.analysisStages {
        if stage == "assembleCells" {
            hasAssembleCells = true
        }
    }
    singleCellChainTsvsData := inputs.singleCellChainTsvsData
    scHeavyOnly := inputs.scHeavyOnly == true
	useStopCodonReplacement := !is_undefined(stopCodonTypes) && is_array(stopCodonTypes) && len(stopCodonTypes) > 0
	if is_undefined(stopCodonReplacements) || !is_map(stopCodonReplacements) {
		stopCodonReplacements = {}
	}

    featureForFlags := inputs.productiveFeature
    if is_undefined(featureForFlags) || featureForFlags == "" {
        featureForFlags = "CDR3"
    }
    isOOFColumn := "isOOF" + featureForFlags
    hasStopsColumn := "hasStopsIn" + featureForFlags

	contains := func(arr, value) {
		for v in arr {
			if v == value { return true }
		}
		return false
	}

	stopReplacement := func(stopType) {
		if !contains(stopCodonTypes, stopType) {
			return "*"
		}
		aa := stopCodonReplacements[stopType]
		if is_undefined(aa) || aa == "" {
			return "*"
		}
		return text.to_upper(aa)
	}

    ll.print("__THE_LOG__", stopReplacement("ochre"))
    ll.print("__THE_LOG__", stopReplacement("amber"))
    ll.print("__THE_LOG__", stopReplacement("opal"))

	codonMapReplace := {
		"TTT": "F", "TTC": "F", "TTA": "L", "TTG": "L",
		"TCT": "S", "TCC": "S", "TCA": "S", "TCG": "S",
		"TAT": "Y", "TAC": "Y", "TAA": stopReplacement("ochre"),
		"TAG": stopReplacement("amber"), "TGT": "C", "TGC": "C",
		"TGA": stopReplacement("opal"), "TGG": "W",
		"CTT": "L", "CTC": "L", "CTA": "L", "CTG": "L",
		"CCT": "P", "CCC": "P", "CCA": "P", "CCG": "P",
		"CAT": "H", "CAC": "H", "CAA": "Q", "CAG": "Q",
		"CGT": "R", "CGC": "R", "CGA": "R", "CGG": "R",
		"ATT": "I", "ATC": "I", "ATA": "I", "ATG": "M",
		"ACT": "T", "ACC": "T", "ACA": "T", "ACG": "T",
		"AAT": "N", "AAC": "N", "AAA": "K", "AAG": "K",
		"AGT": "S", "AGC": "S", "AGA": "R", "AGG": "R",
		"GTT": "V", "GTC": "V", "GTA": "V", "GTG": "V",
		"GCT": "A", "GCC": "A", "GCA": "A", "GCG": "A",
		"GAT": "D", "GAC": "D", "GAA": "E", "GAG": "E",
		"GGT": "G", "GGC": "G", "GGA": "G", "GGG": "G"
	}

	translateNtToAaExpr := func(ntExpr, codonMap) {
		seq := ntExpr.fillNull("").strToUpper()
		seq = seq.strReplace("(.{3})", "$1|", { replaceAll: true })
		for codon, aa in codonMap {
			seq = seq.strReplace(codon + "|", aa + "|", { replaceAll: true, literal: true })
		}
		seq = seq.strReplace("\\|$", "", { replaceAll: false })
		seq = seq.strReplace("|", "", { replaceAll: true, literal: true })
		seq = seq.strReplace("[ACGT]{1,2}$", "", { replaceAll: true })
		return seq
	}

    chainInfos := {
	"IGHeavy": { mixcrFilter: "IGH", name: "IG Heavy", shortName: "Heavy" },
	"IGLight": { mixcrFilter: "IGK,IGL", name: "IG Light", shortName: "Light" },
	"TCRAlpha": { mixcrFilter: "TRA", name: "TCR Alpha", shortName: "Alpha" },
	"TCRBeta": { mixcrFilter: "TRB", name: "TCR Beta", shortName: "Beta" },
	"TCRGamma": { mixcrFilter: "TRG", name: "TCR Gamma", shortName: "Gamma" },
	"TCRDelta": { mixcrFilter: "TRD", name: "TCR Delta", shortName: "Delta" }
    }

    chainsForMixcr := []

    for chain in chains {
        chainsForMixcr += text.split(chainInfos[chain].mixcrFilter, ",")
    }
    
    // Get all clns files from the input data
    clnsFiles := clnsData.inputs()
    
    // Build the exportReportsTable command
    exportReportCmd := exec.builder().
        software(mixcrSw).
        env("MI_USE_SYSTEM_CA", "true").
        secret("MI_LICENSE", "MI_LICENSE").
        env("MI_LICENSE_DEBUG", "MI_LICENSE_DEBUG").
        arg("exportReportsTable")
    
    // Add all clns files as input
    for i, clnsFile in clnsFiles {
        fileName := json.decode(i)[0] + ".clns"
        exportReportCmd.addFile(fileName, clnsFile)
        exportReportCmd.arg(fileName)
    }

    exportReportCmd.arg("qc-report.tsv").saveFile("qc-report.tsv")
    if library {
        if isLibraryFileGzipped {
			exportReportCmd.addFile("library.json.gz", library)
		} else {
			exportReportCmd.addFile("library.json", library)
		}
	}
    
    // Run the command
    result := exportReportCmd.run()

    rawTsvFile := result.getFile("qc-report.tsv")
    
    // Per-sample counts. One small ptabler run per sample reads that sample's clonotype TSVs
    // (one per chain) and its filter TSVs and writes a one-row table. The cohort run below
    // frames only those rows, so its input does not grow with the clonotype count.
    mixcrChainsArg := text.join(chainsForMixcr, ",")

    // Filter exports: one per sample, and in single-cell mode one more per chain per sample.
    // Reads the same .clns as the main clonotype export, so :mem-formula exportRam sizes it
    // with the same rule and the same coefficient.
    filterTsvs := {}
    for key in maps.getKeys(clnsFiles) {
        clnsFile := clnsFiles[key]
        exportFiltersCmd := exec.builder().
            inMediumQueue().
            resources({ onCPU: { cpu: 2, ram: memf.exportRam(inputs.perProcessMemGB, 24, 30) } }).
            software(mixcrSw).
            env("MI_USE_SYSTEM_CA", "true").
            secret("MI_LICENSE", "MI_LICENSE").
            env("MI_LICENSE_DEBUG", "MI_LICENSE_DEBUG").
            arg("exportClones").
            arg("--dont-split-files").
            arg("--drop-default-fields").
            arg("--reset-export-clone-table-splitting")
        if mixcrChainsArg != "" {
            exportFiltersCmd.arg("--chains").arg(mixcrChainsArg)
        }
        exportFiltersCmd = exportFiltersCmd.
            arg("-isOOF").arg(featureForFlags).
            arg("-hasStops").arg(featureForFlags).
            arg("-nFeature").arg(featureForFlags).
            arg("clones.clns").
            addFile("clones.clns", clnsFile, { tag: "clns" }).
            arg("clones.tsv").
            saveFile("clones.tsv")
        if library {
            if isLibraryFileGzipped {
			    exportFiltersCmd.addFile("library.json.gz", library)
		    } else {
			    exportFiltersCmd.addFile("library.json", library)
		    }
		}
        exportFiltersResult := exportFiltersCmd.cacheHours(3).run()
        filterTsvs[key] = exportFiltersResult.getFile("clones.tsv")
    }

    chainFilterTsvs := {}
    if isSingleCell {
        for chain in chains {
            chainMixcr := chainInfos[chain].mixcrFilter
            chainFilterTsvs[chain] = {}
            for key in maps.getKeys(clnsFiles) {
                clnsFile := clnsFiles[key]
                exportChainFiltersCmd := exec.builder().
                    inMediumQueue().
                    resources({ onCPU: { cpu: 2, ram: memf.exportRam(inputs.perProcessMemGB, 24, 30) } }).
                    software(mixcrSw).
                    env("MI_USE_SYSTEM_CA", "true").
                    secret("MI_LICENSE", "MI_LICENSE").
                    env("MI_LICENSE_DEBUG", "MI_LICENSE_DEBUG").
                    arg("exportClones").
                    arg("--dont-split-files").
                    arg("--drop-default-fields").
                    arg("--reset-export-clone-table-splitting").
                    arg("--chains").arg(chainMixcr)
                if library {
                    if isLibraryFileGzipped {
                        exportChainFiltersCmd.addFile("library.json.gz", library)
                    } else {
                        exportChainFiltersCmd.addFile("library.json", library)
                    }
                }
                exportChainFiltersResult := exportChainFiltersCmd.
                    arg("-isOOF").arg(featureForFlags).
                    arg("-hasStops").arg(featureForFlags).
                    arg("-nFeature").arg(featureForFlags).
                    arg("clones.clns").
                    addFile("clones.clns", clnsFile, { tag: "clns" }).
                    arg("clones.tsv").
                    saveFile("clones.tsv").
                    cacheHours(3).
                    run()
                chainFilterTsvs[chain][key] = exportChainFiltersResult.getFile("clones.tsv")
            }
        }
    }

    filterSchema := [ { column: isOOFColumn, type: "String" }, { column: hasStopsColumn, type: "String" } ]
    if useStopCodonReplacement {
        filterSchema = append(filterSchema, { column: "nSeq" + featureForFlags, type: "String" })
    }

    // Marks each row of a filter TSV: __oof = 1 when out of frame, __stop = 1 when the
    // productive feature carries a stop codon (after the configured replacements).
    flagFilterRows := func(df) {
        stopExpr := pt.when(pt.col(hasStopsColumn).strToUpper().eq("TRUE")).then(pt.lit(1)).otherwise(pt.lit(0))
        if useStopCodonReplacement {
            translated := translateNtToAaExpr(pt.col("nSeq" + featureForFlags), codonMapReplace)
            stopExpr = pt.when(translated.strContains("*", { literal: true })).then(pt.lit(1)).otherwise(pt.lit(0))
        }
        return df.withColumns(
            pt.when(pt.col(isOOFColumn).strToUpper().eq("TRUE")).then(pt.lit(1)).otherwise(pt.lit(0)).alias("__oof"),
            stopExpr.alias("__stop")
        )
    }

    // Columns of the one-row per-sample table, besides sampleId. All Long.
    countColumns := [
        "exportedClonotypes",
        "readsUsedInClonotypesNew",
        "assemble.clonotypesDroppedByOutOfFrame",
        "assemble.clonotypesDroppedByStopCodons"
    ]
    for chain in chains {
        countColumns = append(countColumns, "clonotypesByChain." + chain)
        if isSingleCell {
            countColumns = append(countColumns, "assemble.clonotypesDroppedByOutOfFrameByChain." + chain)
            countColumns = append(countColumns, "assemble.clonotypesDroppedByStopCodonsByChain." + chain)
        }
    }
    if isSingleCell {
        countColumns = append(countColumns, "scCellsTotal", "scCellsBothChains", "exportedClonotypesPaired")
        for chain in chains {
            countColumns = append(countColumns, "clonotypesByChain." + chain + ".paired")
        }
    }

    countsFiles := []
    for key in maps.getKeys(clnsFiles) {
        sampleId := json.decode(key)[0]
        swf := pt.workflow().
            inMediumQueue().
            memFloor(PER_SAMPLE_COUNTS_MEM_FLOOR_GIB * units.GiB).
            cpu(PER_SAMPLE_COUNTS_CPU)

        row := flagFilterRows(swf.frame(filterTsvs[key], { xsvType: "tsv", inferSchema: false, schema: filterSchema })).select(
            pt.lit(sampleId).alias("sampleId"),
            pt.col("__oof").sum().alias("assemble.clonotypesDroppedByOutOfFrame"),
            pt.col("__stop").sum().alias("assemble.clonotypesDroppedByStopCodons")
        )

        totalExpr := pt.lit(0)
        readsExpr := pt.lit(0)
        for chain in chains {
            chainCol := "clonotypesByChain." + chain
            readsCol := "__reads." + chain
            chainData := clonotypeTablesData[chain]
            clonesFile := is_undefined(chainData) ? undefined : chainData.inputs()[key]
            if is_undefined(clonesFile) {
                row = row.withColumns(pt.lit(0).alias(chainCol), pt.lit(0).alias(readsCol))
            } else {
                chainCounts := swf.frame(clonesFile, { xsvType: "tsv", inferSchema: false, schema: [ { column: "readCount", type: "Double" } ] }).select(
                    pt.lit(sampleId).alias("sampleId"),
                    pt.col("clonotypeKey").count().alias(chainCol),
                    pt.col("readCount").round().cast("Long").sum().alias(readsCol)
                )
                row = row.join(chainCounts, { how: "left", on: ["sampleId"] })
            }
            totalExpr = totalExpr.plus(pt.col(chainCol).fillNull(0))
            readsExpr = readsExpr.plus(pt.col(readsCol).fillNull(0))

            if isSingleCell {
                oofCol := "assemble.clonotypesDroppedByOutOfFrameByChain." + chain
                stopCol := "assemble.clonotypesDroppedByStopCodonsByChain." + chain
                chainFilterTsv := chainFilterTsvs[chain][key]
                if is_undefined(chainFilterTsv) {
                    row = row.withColumns(pt.lit(0).alias(oofCol), pt.lit(0).alias(stopCol))
                } else {
                    chainFilterCounts := flagFilterRows(swf.frame(chainFilterTsv, { xsvType: "tsv", inferSchema: false, schema: filterSchema })).select(
                        pt.lit(sampleId).alias("sampleId"),
                        pt.col("__oof").sum().alias(oofCol),
                        pt.col("__stop").sum().alias(stopCol)
                    )
                    row = row.join(chainFilterCounts, { how: "left", on: ["sampleId"] })
                }
            }
        }
        row = row.withColumns(
            totalExpr.alias("exportedClonotypes"),
            readsExpr.alias("readsUsedInClonotypesNew")
        )

        // Single-cell: cell pairing statistics for this sample from its single-cell chain
        // TSVs (cellKey, clonotypeKey per chain). A cell is paired when it carries more than
        // pairMinExclusive distinct chains: 2 for paired receptors, 1 for heavy-chain-only.
        if isSingleCell {
            scDfs := []
            if !is_undefined(singleCellChainTsvsData) {
                for chain in chains {
                    chainFiles := singleCellChainTsvsData[chain]
                    scFile := is_undefined(chainFiles) ? undefined : chainFiles.inputs()[key]
                    if is_undefined(scFile) {
                        continue
                    }
                    scDfs = append(scDfs, swf.frame(scFile, { xsvType: "tsv", inferSchema: false, schema: [ { column: "cellKey", type: "String" }, { column: "clonotypeKey", type: "String" } ] }).select(
                        pt.col("cellKey"),
                        pt.col("clonotypeKey"),
                        pt.lit(chain).alias("chain")
                    ))
                }
            }
            if len(scDfs) == 0 {
                zeroExprs := [
                    pt.lit(0).alias("scCellsTotal"),
                    pt.lit(0).alias("scCellsBothChains"),
                    pt.lit(0).alias("exportedClonotypesPaired")
                ]
                for chain in chains {
                    zeroExprs = append(zeroExprs, pt.lit(0).alias("clonotypesByChain." + chain + ".paired"))
                }
                row = row.withColumns(zeroExprs...)
            } else {
                scAll := len(scDfs) > 1 ? pt.concat(scDfs) : scDfs[0]
                pairMinExclusive := scHeavyOnly ? 0 : 1
                pairedKeys := scAll.groupBy("cellKey").agg(pt.col("chain").nUnique().alias("_numChains")).
                    filter(pt.col("_numChains").gt(pairMinExclusive)).
                    select(pt.col("cellKey"))
                scPaired := scAll.join(pairedKeys, { how: "inner", on: ["cellKey"] })

                cellCounts := scAll.select(
                    pt.lit(sampleId).alias("sampleId"),
                    pt.col("cellKey").nUnique().alias("scCellsTotal")
                )
                pairedCellCounts := pairedKeys.select(
                    pt.lit(sampleId).alias("sampleId"),
                    pt.col("cellKey").count().alias("scCellsBothChains")
                )
                row = row.join(cellCounts, { how: "left", on: ["sampleId"] }).
                    join(pairedCellCounts, { how: "left", on: ["sampleId"] })

                pairedTotalExpr := pt.lit(0)
                for chain in chains {
                    colPaired := "clonotypesByChain." + chain + ".paired"
                    if is_undefined(singleCellChainTsvsData[chain]) {
                        row = row.withColumns(pt.lit(0).alias(colPaired))
                    } else {
                        chainPaired := scPaired.filter(pt.col("chain").eq(chain)).select(
                            pt.lit(sampleId).alias("sampleId"),
                            pt.col("clonotypeKey").nUnique().alias(colPaired)
                        )
                        row = row.join(chainPaired, { how: "left", on: ["sampleId"] })
                    }
                    pairedTotalExpr = pairedTotalExpr.plus(pt.col(colPaired).fillNull(0))
                }
                row = row.withColumns(pairedTotalExpr.alias("exportedClonotypesPaired"))
            }
        }

        selectExprs := [ pt.col("sampleId") ]
        for c in countColumns {
            selectExprs = append(selectExprs, pt.col(c).cast("Long"))
        }
        row.select(selectExprs...).save("counts.tsv")

        countsFiles = append(countsFiles, swf.run().getFile("counts.tsv"))
    }

    // Cohort run: the qc report joined with the per-sample count rows. Every frame here has
    // one row per sample, so the run stays flat in clonotype and cell count.
    wf := pt.workflow().
        inMediumQueue().
        mem("8GiB").
        cpu(2)

    df := wf.frame(rawTsvFile, {
        xsvType: "tsv",
        inferSchema: false
    })

    // Add the sampleId column: fileName without the ".clns" suffix
    processedDf := df.withColumns(
        pt.col("fileName").strSlice(0, pt.col("fileName").strLenChars().minus(5)).alias("sampleId")
    )

    countsSchema := [ { column: "sampleId", type: "String" } ]
    for c in countColumns {
        countsSchema = append(countsSchema, { column: c, type: "Long" })
    }
    countsDfs := []
    for f in countsFiles {
        countsDfs = append(countsDfs, wf.frame(f, { xsvType: "tsv", inferSchema: false, schema: countsSchema }))
    }

    joinedDf := processedDf
    if len(countsDfs) > 0 {
        countsAll := len(countsDfs) > 1 ? pt.concat(countsDfs) : countsDfs[0]
        joinedDf = processedDf.join(countsAll, { how: "left", on: ["sampleId"] })
    } else {
        for c in countColumns {
            joinedDf = joinedDf.withColumns(pt.lit(0).alias(c))
        }
    }

    // Finalize: cast/fill totals and per-chain counts
    finalDf := joinedDf
    if isSingleCell {
        // Use paired-only totals and per-chain counts
        // Replace per-chain columns from ".paired" variants and set total from exportedClonotypesPaired
        for chain in chains {
            colPaired := "clonotypesByChain." + chain + ".paired"
            col := "clonotypesByChain." + chain
            finalDf = finalDf.withColumns(pt.col(colPaired).fillNull(0).cast("Long").alias(col))
        }
        finalDf = finalDf.withColumns(
            pt.col("exportedClonotypesPaired").fillNull(0).cast("Long").alias("totalClonotypes"),
            pt.col("readsUsedInClonotypesNew").fillNull(0).cast("Long").alias("readsUsedInClonotypes")
        )
        if !scHeavyOnly {
            // Clonotypes dropped because their cell lacked a paired chain.
            // Not applicable in heavy-chain-only (VHH) mode (column omitted from spec).
            finalDf = finalDf.withColumns(
                pt.col("exportedClonotypes").fillNull(0).cast("Long").minus(pt.col("exportedClonotypesPaired").fillNull(0).cast("Long")).alias("clonotypesDroppedUnpaired")
            )
        }
    } else {
        finalDf = finalDf.withColumns(
            pt.col("exportedClonotypes").fillNull(0).cast("Long").alias("totalClonotypes"),
            pt.col("readsUsedInClonotypesNew").fillNull(0).cast("Long").alias("readsUsedInClonotypes")
        )
        for chain in chains {
            col := "clonotypesByChain." + chain
            finalDf = finalDf.withColumns(
                pt.col(col).fillNull(0).cast("Long").alias(col)
            )
        }
    }

    finalDf = finalDf.withColumns(
        pt.col("assemble.clonotypesDroppedByOutOfFrame").fillNull(0).cast("Long").alias("assemble.clonotypesDroppedByOutOfFrame"),
        pt.col("assemble.clonotypesDroppedByStopCodons").fillNull(0).cast("Long").alias("assemble.clonotypesDroppedByStopCodons")
    )
    if isSingleCell {
        for chain in chains {
            finalDf = finalDf.withColumns(
                pt.col("assemble.clonotypesDroppedByOutOfFrameByChain." + chain).fillNull(0).cast("Long").alias("assemble.clonotypesDroppedByOutOfFrameByChain." + chain),
                pt.col("assemble.clonotypesDroppedByStopCodonsByChain." + chain).fillNull(0).cast("Long").alias("assemble.clonotypesDroppedByStopCodonsByChain." + chain)
            )
        }
    }

    if isSingleCell {
        // scCellsTotal: paired mode reports cells with both chains; heavy-only (VHH) mode
        // reports all cells carrying the single chain (the genuine unique-cell count).
        finalDf = finalDf.withColumns(
            (scHeavyOnly ? pt.col("scCellsTotal") : pt.col("scCellsBothChains")).fillNull(0).cast("Long").alias("scCellsTotal")
        )
    }
    
    // Save the final DataFrame back to TSV
    finalDf.save("qc-report-processed.tsv", {
        xsvType: "tsv"
    })
    
    // Run the pTabler workflow
    wfResult := wf.run()
    
    tsvFile := wfResult.getFile("qc-report-processed.tsv")

    qcReportColumns := qcReportColumns(hasUmi, isSingleCell, sampleIdAxisSpec, chains, cellTags, umiTags, hasAssembleCells, scHeavyOnly)
    reportColumnsSpec := qcReportColumns.reportColumnsSpec

    qcReportTable := xsv.importFile(
		tsvFile,
		"tsv",
		reportColumnsSpec,
		{ cpu: 1, mem: "16GiB" }
	)

    
    return {
        qcReportTable: qcReportTable
    }
})