// Identity of this template for the platform's deduplication.
//
// CHANGING THIS VALUE MEANS "RE-RUN EVERY SAMPLE ON THE NEXT BLOCK UPDATE".
//
// List of template's inputs + values of inputs + this hash decides whether an analysis is
// repeated or needs to be run again.
//
// An override replaces the identity of the WHOLE subtree, not of this file: the backend
// renders an overridden template as a `TengoTemplateOverride` resource carrying the UUID
// alone, with the real template on a Service field. So a rotated UUID in a template this one
// renders — :run-mixcr, :chain-mixcr — has no effect while this UUID stands. Rotate here
// whenever the computation below changes.
//tengo:hash_override 71DF4AA6-D7E8-4D74-A9DF-340C28229422

// Measures the reads of one sample, then runs MiXCR on them.
//
// MiXCR needs disposable disk space for its temporary files, sized from the sample's read
// count and read length. Measuring those is a command, and a template cannot read the result
// of a command it started itself, so the run lives in :run-mixcr and this template only
// feeds it. See :read-stats for what is measured and how the size follows from it.
//
// The override was rotated when MiXCR stopped running as one `analyze` command, so every
// sample is analysed again on the next block update.

self := import("@platforma-sdk/workflow-tengo:tpl")
render := import("@platforma-sdk/workflow-tengo:render")
assets := import("@platforma-sdk/workflow-tengo:assets")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")

readStats := import(":read-stats")

self.defineOutputs("qc", "reports", "log", "clns")

runMixcrTpl := assets.importTemplate(":run-mixcr")

self.body(func(inputs) {
	inputData := inputs[pConstants.VALUE_FIELD_NAME]
	params := inputs.params

	runMixcr := render.create(
		runMixcrTpl,
		{
			"__value__": inputData,
			"__aggregation_axes_names__": inputs[pConstants.AGGREGATION_AXES_NAMES_FIELD_NAME],

			preset: inputs.preset,
			params: params,
			library: inputs.library,
			presetContent: inputs.presetContent,

			readStats: readStats.measure(inputData, params.fileExtension)
		},
		{
			// Kept out of the deduplication key, the way process.tpl.tengo passes them to this
			// template: a run may be recovered across a change of the CPU or memory override.
			metaInputs: {
				perProcessMemGB: inputs.perProcessMemGB,
				perProcessCPUs: inputs.perProcessCPUs
			}
		}
	)

	return {
		qc: runMixcr.output("qc", readStats.CACHE_PERIOD),
		log: runMixcr.output("log", readStats.CACHE_PERIOD),
		reports: runMixcr.output("reports", readStats.CACHE_PERIOD),
		clns: runMixcr.output("clns", readStats.CACHE_PERIOD)
	}
})
