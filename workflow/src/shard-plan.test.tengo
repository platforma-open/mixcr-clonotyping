test := import("@platforma-sdk/workflow-tengo:test")
sp := import(":shard-plan")

GIB := 1024 * 1024 * 1024

TestNeedGiBFollowsBytes := func() {
	test.isEqual(sp.INTERCEPT_GIB, sp.needGiB(0))
	test.isEqual(sp.INTERCEPT_GIB + 6, sp.needGiB(1 * GIB))
	// one byte over rounds up to the next GiB
	test.isEqual(sp.INTERCEPT_GIB + 7, sp.needGiB(1 * GIB + 1))
}

TestShardLettersDealEveryLetterOnce := func() {
	one := sp.shardLetters(1)
	test.isEqual(1, len(one))
	test.isEqual(sp.LETTERS, one[0])

	seven := sp.shardLetters(7)
	test.isEqual(7, len(seven))
	total := 0
	for s in seven {
		total += len(s)
	}
	test.isEqual(26, total)
	// round-robin: shard 0 takes A, H, O, V; shard 6 takes G, N, U
	test.isEqual("AHOV", seven[0])
	test.isEqual("GNU", seven[6])

	all := sp.shardLetters(26)
	test.isEqual(26, len(all))
	test.isEqual("A", all[0])
	test.isEqual("Z", all[25])
}

TestPlanSmallCohortIsOneShardAtDefault := func() {
	// 1 GiB of TSV needs 8 GiB: one shard, granted the 64 GiB default.
	p := sp.plan(1 * GIB)
	test.isEqual(1, len(p.shards))
	test.isEqual(sp.LETTERS, p.shards[0])
	test.isEqual(sp.DEFAULT_SHARD_GIB, p.memGiB)
	test.isEqual(sp.SHARD_CPU, p.cpu)
}

TestPlanUnknownBytesIsOneShard := func() {
	p := sp.plan(undefined)
	test.isEqual(1, len(p.shards))
	test.isEqual(sp.DEFAULT_SHARD_GIB, p.memGiB)
}

TestPlanLargestShardStaysUnderDefault := func() {
	// 65 GiB of TSV: 2 + 6 x 65 = 392 GiB in one run.
	// 7 shards -> 4 letters -> 10 GiB -> 62 GiB fits; 6 shards -> 5 letters -> 12.5 -> 77 does not.
	p := sp.plan(65 * GIB)
	test.isEqual(7, len(p.shards))
	test.isEqual(sp.DEFAULT_SHARD_GIB, p.memGiB)

	// 260 GiB of TSV: only 26 shards bring a shard to 10 GiB -> 62.
	p = sp.plan(260 * GIB)
	test.isEqual(26, len(p.shards))
	test.isEqual(sp.DEFAULT_SHARD_GIB, p.memGiB)
}

TestPlanBeyondTwentySixShardsRequestsTheNeed := func() {
	// 1 TiB of TSV: 26 shards leave 39.4 GiB per shard -> 2 + 237 GiB > 64.
	p := sp.plan(1024 * GIB)
	test.isEqual(26, len(p.shards))
	test.isEqual(sp.needGiB((1024 * GIB + 25) / 26), p.memGiB)
	test.isTrue(p.memGiB > sp.DEFAULT_SHARD_GIB)
}
