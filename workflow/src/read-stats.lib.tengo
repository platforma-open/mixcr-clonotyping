// Single source of truth for the `mixcr analyze` scratch space request.
//
// Two shapes of temporary data compete for the space, and the run needs whichever is
// larger:
//
//     S   = 4.0 x millionsOfReads x (lengthOfR1 + lengthOfR2) / 1000
//     C   = 11  x millionsOfReads x (lengthOfTheLongestRead / 1000) ^ 2
//     GiB = max(S, C)
//
// S scales with the volume of the input — four bytes per base of the pair. C is quadratic in
// read length, so it overtakes S only on long reads.
//
// None of those numbers is in the p-column metadata, so the reads are measured: a custom
// metric collector (exec.formula.collector) runs 'seqkit stats' over the read files and 'jq'
// folds its table into the four metrics the formula reads. The platform runs the collector
// before the step it sizes and evaluates the formula there, so the template that builds the
// step needs no measurement of its own. Every step of a sample reads the same files, so the
// collector runs once per sample however many steps it sizes.
//
// The request is an optimisation and never a precondition. A deployment with no scratch
// storage, or a sample with no read end to measure, gets 'undefined' and the field is left
// out; a backend that cannot evaluate formulas leaves a formula with no fallback out the same
// way. The command still gets a temporary directory: the SDK guarantees TMPDIR on every
// backend, on the working directory's own filesystem where no device exists. Only the SIZE is
// unavailable, never the directory.

exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
feats := import("@platforma-sdk/workflow-tengo:feats")
maps := import("@platforma-sdk/workflow-tengo:maps")
slices := import("@platforma-sdk/workflow-tengo:slices")

times := import("times")
text := import("text")

f := exec.formula

seqkitSw := assets.importSoftware("@platforma-open/milaboratories.software-binary-collection:seqkit")
jqSw := assets.importSoftware("@platforma-open/milaboratories.software-binary-collection:jq")

// How long a measurement may be reused. Matches the MiXCR run cache, so a repeated analysis
// of the same sample reads the files no more often than it runs MiXCR.
CACHE_PERIOD := 48 * times.hour

// The metrics the collector writes.
//   reads       - reads of the sample, counted on R1 alone: it counts pairs, so adding R2
//                 would double it
//   basesR1     - bases of every R1 file, summed; summing rather than averaging is exact and
//                 needs no weighting when a sample spans lanes
//   basesR2     - the same for R2
//   longestRead - the longest read of either end
METRICS := ["reads", "basesR1", "basesR2", "longestRead"]

// Folds the table of 'seqkit stats --tabular' (a header line plus one line per file) into a
// JSON object of the metrics. Fields are read by header name, not by column position. A file
// is R2 when its name says so ("input_R2.fastq.gz", "input_L1_R2.fastq.gz"); every other file
// given is R1, which also covers the single "input.fastq.gz" of a sample with no read index.
// An empty table gives zeros.
_FOLD_PROGRAM := `split("\n") | map(select(length > 0) | split("\t")) | .[0] as $h | .[1:]
| map(. as $r | reduce range(0; $h | length) as $i ({}; .[$h[$i]] = $r[$i]))
| map(.r2 = (.file | test("_R2[._]")))
| {
    reads: (map(select(.r2 | not) | .num_seqs | tonumber) | add // 0),
    basesR1: (map(select(.r2 | not) | .sum_len | tonumber) | add // 0),
    basesR2: (map(select(.r2) | .sum_len | tonumber) | add // 0),
    longestRead: (map(.max_len | tonumber) | max // 0)
  }`

// _measure is the collector's builder: 'seqkit stats' over the files, then 'jq' over its table.
//
// seqkit reads every file whole, so it gets the same queue as other data passes. One core per
// file: seqkit parallelises across files, not within one, so a core beyond their number would
// idle. The command reads the granted count back from '{system.cpu}' instead of repeating the
// number, so the request and the flag can never diverge.
_measure := func(files) {
	names := slices.quickSort(maps.getKeys(files))
	stats := exec.builder().
		name("seqkit stats").
		inMediumQueue().
		cpu(len(names)).
		mem("1GiB").
		software(seqkitSw).
		arg("stats").
		arg("--threads").
		argExpr("{system.cpu}").
		arg("--tabular")
	for name in names {
		stats.addFile(name, files[name]).arg(name)
	}
	statsFile := stats.saveStdoutFile().cache(CACHE_PERIOD).run().getStdoutFile()

	return exec.builder().
		name("read stats").
		inLightQueue().
		cpu(1).
		mem("256MiB").
		software(jqSw).
		addFile("stats.tsv", statsFile).
		arg("--raw-input").
		arg("--slurp").
		arg("--compact-output").
		arg(_FOLD_PROGRAM).
		arg("stats.tsv").
		cache(CACHE_PERIOD)
}

// readsToMeasure picks the read ends to measure from the files a step stages, by the names
// :run-mixcr gives them: "input.<ext>", "input_R1.<ext>", "input_L1_R2.<ext>". Index reads
// (I1, I2) are left out: they carry tags, not the sequence the run has to sort.
readsToMeasure := func(files) {
	reads := {}
	for name, file in files {
		if text.contains(name, "_I1") || text.contains(name, "_I2") {
			continue
		}
		reads[name] = file
	}
	return reads
}

// scratchFormula is the scratch space of the steps of one sample, a formula over the metrics
// `stats` (a collector over the sample's reads) writes:
//
//     S = ceil(4 x (basesR1 + basesR2) / 10^9)
//     C = ceil(11 x ceil(reads / 1000) x longestRead^2 / 10^9)
//     GiB = max(S, C, 1)
//
// in whole GiB, rounded up, so the integer-only formula keeps the bound of the float one. The
// read count goes in as thousands so C cannot overflow: 10^10 reads of 10^5 bases stay under
// 2^63. A request below one GiB is raised to one, as a sample small enough to need less still
// needs scratch space.
scratchFormula := func(stats) {
	volume := stats.metric("basesR1").plus(stats.metric("basesR2")).times(4).dividedBy(1000000000)
	length := stats.metric("reads").dividedBy(1000).times(11).
		times(stats.metric("longestRead")).times(stats.metric("longestRead")).dividedBy(1000000000)
	return volume.atLeast(length).atLeast(1).times(f.gib(1))
}

// scratchFreeSpace returns the request for `.resources({onCPU:{scratchFreeSpace}})` of every
// step of a sample, given the sample's read files by the names the steps stage them under, or
// 'undefined' when there is nothing to size on.
scratchFreeSpace := func(files) {
	// A deployment with no scratch storage cannot act on a SIZE, so the reads are not read at
	// all: the pass costs a full decompression per sample.
	if !feats.hasScratchSpace {
		return undefined
	}
	reads := readsToMeasure(files)
	if len(reads) == 0 {
		return undefined
	}
	stats := f.collector("readStats", { metrics: METRICS, files: reads, builder: _measure, output: "stdout" })
	return scratchFormula(stats)
}

export {
	CACHE_PERIOD: CACHE_PERIOD,
	METRICS: METRICS,
	readsToMeasure: readsToMeasure,
	scratchFormula: scratchFormula,
	scratchFreeSpace: scratchFreeSpace
}
