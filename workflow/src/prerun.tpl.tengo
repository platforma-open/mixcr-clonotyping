// pre-run

wf := import("@platforma-sdk/workflow-tengo:workflow")
maps := import("@platforma-sdk/workflow-tengo:maps")
render := import("@platforma-sdk/workflow-tengo:render")
ll := import("@platforma-sdk/workflow-tengo:ll")
smart := import("@platforma-sdk/workflow-tengo:smart")
assets := import("@platforma-sdk/workflow-tengo:assets")
file := import("@platforma-sdk/workflow-tengo:file")

listPresetsTpl := assets.importTemplate(":list-presets")
calculatePresetInfoTpl := assets.importTemplate(":calculate-preset-info")
planStepsTpl := assets.importTemplate(":plan-steps")
presetSupportTpl := assets.importTemplate(":preset-support")

wf.body(func(args) {

	// (begin) @TODO To be moved to SDK / Model

	fileImports := {}

	importFile := func(importHandle) {
		fromMap := fileImports[importHandle]
		if fromMap == undefined {
			fImport := file.importFile(importHandle)
			fileImports[importHandle] = fImport
			return fImport.file
		} else {
			return fromMap.file
		}
	}

	// (end)

	outputs := {}

	listPresets := render.create(listPresetsTpl, {})
	outputs.presets = listPresets.output("presets", 24 * 60 * 60 * 1000)

	if !is_undefined(args.preset) {

		preset := args.preset

		// file or json with preset name
		presetResource := undefined

		if preset.type == "file" {
			//presetResource = importFile(preset.file)
			presetResource = undefined
		} else {
			ll.assert(preset.type == "name", "unexpected preset type")
			// whole json, including type
			presetResource = smart.createJsonResource(preset)
			isGenericPreset := args.isGenericPreset
			presetInfoResult := render.create(calculatePresetInfoTpl, {
				preset: presetResource,
				params: {
					species: args.species,
					leftAlignmentMode: args.leftAlignmentMode,
					rightAlignmentMode: args.rightAlignmentMode,
					materialType: args.materialType,
					tagPattern: isGenericPreset ? "^(R1:*)\\^(R2:*)" : undefined,
					assembleClonesBy: isGenericPreset ? "CDR3" : undefined
				}
			})
			outputs.preset = presetInfoResult.output("presetSpecForBack", 24 * 60 * 60 * 1000)

			// Whether the block runs this preset at all, shown beside the preset before any run.
			presetSupport := render.create(presetSupportTpl, {
				presetContent: presetInfoResult.output("preset", 24 * 60 * 60 * 1000)
			})
			outputs.presetSupport = presetSupport.output("presetSupport", 24 * 60 * 60 * 1000)

			// The steps the "Per-step resources" settings list, planned only once the operator
			// asks for them. A generic preset needs a tag pattern to plan, so it takes the one
			// above until the operator sets their own.
			if args.listSteps {
				genericTagPattern := isGenericPreset ? "^(R1:*)\\^(R2:*)" : undefined
				genericAssembleBy := isGenericPreset ? "CDR3" : undefined
				planSteps := render.create(planStepsTpl, {
					preset: presetResource,
					params: {
						species: args.species,
						leftAlignmentMode: args.leftAlignmentMode,
						rightAlignmentMode: args.rightAlignmentMode,
						materialType: args.materialType,
						tagPattern: is_undefined(args.tagPattern) ? genericTagPattern : args.tagPattern,
						assembleClonesBy: is_undefined(args.assembleClonesBy) ? genericAssembleBy : args.assembleClonesBy,
						cloneClusteringMode: args.cloneClusteringMode
					},
					presetContent: presetInfoResult.output("preset", 24 * 60 * 60 * 1000)
				})
				outputs.stepDefaults = planSteps.output("stepDefaults", 24 * 60 * 60 * 1000)
			}
		}
	}

	outputs.fileImports = smart.createMapResource(maps.mapValues(fileImports, func(im) {
		return im.handle
	}))

	return {
		outputs: outputs,
		exports: {}
	}
})
