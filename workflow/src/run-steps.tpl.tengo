// Inert while :mixcr-analyze carries its own override; must stay unique across templates.
//tengo:hash_override 0E53B0CD-37CB-4740-BE98-3195AE3C96F8

// Runs the steps `mixcr analyze --dry-run-json` planned for one sample, one exec per step, each
// with its CPU and memory from :resources.
//
// A template cannot read the result of a command it started, so the planning command runs in
// :run-mixcr and this template reads back the step list it wrote.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
assets := import("@platforma-sdk/workflow-tengo:assets")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
render := import("@platforma-sdk/workflow-tengo:render")
smart := import("@platforma-sdk/workflow-tengo:smart")
times := import("times")
mixcrCmd := import(":mixcr-cmd")
mixcrSteps := import(":mixcr-steps")
resources := import(":resources")

self.defineOutputs("qc", "reports", "log", "stepRequest", "clns")

mixcrSw := assets.importSoftware("@platforma-open/milaboratories.software-mixcr:memory-from-limits")
stepRequestTpl := assets.importTemplate(":step-request")

CACHE_PERIOD := 48 * times.hour
// For the steps that write no final output (the clones or the qc result).
INTERMEDIATE_CACHE_PERIOD := 36 * times.hour

self.body(func(inputs) {
	// name -> file: the template base unmarshals the map input, set fields and pending alike.
	files := inputs.files
	readNames := inputs.readNames
	res := {
		perProcessMemGB: inputs.perProcessMemGB,
		perProcessCPUs: inputs.perProcessCPUs,
		stepResources: inputs.stepResources,
		scratchFreeSpace: inputs.scratchFreeSpace
	}
	// The overrides as :step-request reads them; an unset one is left out.
	overrides := {}
	for k in ["perProcessMemGB", "perProcessCPUs", "stepResources"] {
		if !is_undefined(res[k]) {
			overrides[k] = res[k]
		}
	}

	// :step-request renders only when the block reports step requests; off, the output is null.
	reportStepRequests := inputs.reportStepRequests == true

	plan := mixcrSteps.commands(mixcrSteps.stepsOf(inputs.steps.getDataAsJson()), files, inputs.readsPattern)

	written := {}
	// One stream per step, keyed by its run position and name (`007:align`). Carried as the
	// sample's `log` output: a run from before the split holds a single stream there instead.
	stepLogs := pcolumn.resourceMapBuilder( /* keyLength */ 1 )
	stepRequests := pcolumn.resourceMapBuilder( /* keyLength */ 1 )
	for c in plan.commands {
		// The name is the job's label on the backend (the k8s job name, the failure message).
		cmd := mixcrCmd.builder(mixcrSw).name("mixcr " + c.key).arg(c.args[0])
		if c.key == "align" {
			// `--threads` reads the granted count back from the placeholder, so the flag and the
			// request cannot diverge. `analyze` prints it only when it is given one.
			cmd.arg("--threads").argExpr("{system.cpu}")
		}
		for arg in c.args[1:] {
			cmd.arg(arg)
		}
		// The files the step is sized from, which :step-request sizes it from too.
		sizedFiles := smart.mapBuilder()
		for name in c.stageSteps {
			cmd.addFile(name, written[name], { tag: resources.INPUT_TAG })
			sizedFiles.addRef(name, written[name])
		}
		if c.stageReads {
			for name in readNames {
				cmd.addFile(name, files[name], { tag: resources.INPUT_TAG })
				sizedFiles.addRef(name, files[name])
			}
		}
		for name in c.stageBlock {
			cmd.addFile(name, files[name])
		}
		for name in c.save {
			cmd.saveFile(name)
		}
		row := resources.lookup(c.key, inputs.stepClass)
		resources.apply(cmd, row, res)
		cachePeriod := c.writesFinalOutput ? CACHE_PERIOD : INTERMEDIATE_CACHE_PERIOD
		run := cmd.cache(cachePeriod).run()
		stepLogs.add([c.logKey], run.getStdoutStream())

		if reportStepRequests {
			request := render.create(stepRequestTpl, {
				step: c.key,
				files: sizedFiles.lockAndBuild(),
				row: row,
				overrides: overrides
			})
			stepRequests.add([c.logKey], request.output("request", cachePeriod))
		}
		for name in c.save {
			written[name] = run.getFile(name)
		}
	}

	// The reports p-column carries the ids :process lists, under the names `analyze` gives them.
	reportsMap := pcolumn.resourceMapBuilder( /* keyLength */ 2 )
	for report in inputs.reports {
		for name in [report.fileJson, report.fileTxt] {
			ll.assert(!is_undefined(written[name]), "no MiXCR step writes the %v report %v", report.id, name)
		}
		reportsMap.add([report.id, "json"], written[report.fileJson])
		reportsMap.add([report.id, "txt"], written[report.fileTxt])
	}

	return {
		qc: written[plan.qcJson],
		log: stepLogs.build(),
		stepRequest: reportStepRequests ? stepRequests.build() : smart.createNullResource(),
		reports: reportsMap.build(),
		clns: written[plan.clns]
	}
})
