// One sample's QC count row: clonotype counts per chain, reads used, clonotypes dropped as
// out of frame or carrying stop codons, and in single-cell mode the cell pairing statistics.
// Reads that sample's filter TSV(s) and clonotype TSV(s) and writes a one-row table that
// :export-report joins across the cohort.
//
// :process creates one render per sample, so each run starts when its own inputs exist.
// Launched from :export-report's body, after every clns was final, the 1,718 runs of a
// large dataset went out in one burst and tripped the backend's job appear timeout.

self := import("@platforma-sdk/workflow-tengo:tpl.light")
pt := import("@platforma-sdk/workflow-tengo:pt")
units := import("@platforma-sdk/workflow-tengo:units")
text := import("text")

self.defineOutputs("counts")

// Memory is left to the SDK, which sizes the run from the blob size of the sample's TSVs,
// with this floor. The bulk counts stream, but the single-cell pairing statistics group by
// cellKey and join, which polars runs in memory.
PER_SAMPLE_COUNTS_MEM_FLOOR_GIB := 8
PER_SAMPLE_COUNTS_CPU := 2

self.body(func(inputs) {
    params := inputs.params
    chains := params.chains
    isSingleCell := params.isSingleCell == true
    scHeavyOnly := params.scHeavyOnly == true
    stopCodonTypes := params.stopCodonTypes
    stopCodonReplacements := params.stopCodonReplacements

    filterTsv := inputs.filterTsv
    // chain -> TSV; a chain without a table is absent. All three are empty for bulk presets
    // where not applicable.
    clonotypeTables := inputs.clonotypeTables
    chainFilterTsvs := inputs.chainFilterTsvs
    scChainTsvs := inputs.scChainTsvs

	useStopCodonReplacement := !is_undefined(stopCodonTypes) && is_array(stopCodonTypes) && len(stopCodonTypes) > 0
	if is_undefined(stopCodonReplacements) || !is_map(stopCodonReplacements) {
		stopCodonReplacements = {}
	}

    featureForFlags := params.productiveFeature
    if is_undefined(featureForFlags) || featureForFlags == "" {
        featureForFlags = "CDR3"
    }
    isOOFColumn := "isOOF" + featureForFlags
    hasStopsColumn := "hasStopsIn" + featureForFlags

	contains := func(arr, value) {
		for v in arr {
			if v == value { return true }
		}
		return false
	}

	stopReplacement := func(stopType) {
		if !contains(stopCodonTypes, stopType) {
			return "*"
		}
		aa := stopCodonReplacements[stopType]
		if is_undefined(aa) || aa == "" {
			return "*"
		}
		return text.to_upper(aa)
	}


	codonMapReplace := {
		"TTT": "F", "TTC": "F", "TTA": "L", "TTG": "L",
		"TCT": "S", "TCC": "S", "TCA": "S", "TCG": "S",
		"TAT": "Y", "TAC": "Y", "TAA": stopReplacement("ochre"),
		"TAG": stopReplacement("amber"), "TGT": "C", "TGC": "C",
		"TGA": stopReplacement("opal"), "TGG": "W",
		"CTT": "L", "CTC": "L", "CTA": "L", "CTG": "L",
		"CCT": "P", "CCC": "P", "CCA": "P", "CCG": "P",
		"CAT": "H", "CAC": "H", "CAA": "Q", "CAG": "Q",
		"CGT": "R", "CGC": "R", "CGA": "R", "CGG": "R",
		"ATT": "I", "ATC": "I", "ATA": "I", "ATG": "M",
		"ACT": "T", "ACC": "T", "ACA": "T", "ACG": "T",
		"AAT": "N", "AAC": "N", "AAA": "K", "AAG": "K",
		"AGT": "S", "AGC": "S", "AGA": "R", "AGG": "R",
		"GTT": "V", "GTC": "V", "GTA": "V", "GTG": "V",
		"GCT": "A", "GCC": "A", "GCA": "A", "GCG": "A",
		"GAT": "D", "GAC": "D", "GAA": "E", "GAG": "E",
		"GGT": "G", "GGC": "G", "GGA": "G", "GGG": "G"
	}

	translateNtToAaExpr := func(ntExpr, codonMap) {
		seq := ntExpr.fillNull("").strToUpper()
		seq = seq.strReplace("(.{3})", "$1|", { replaceAll: true })
		for codon, aa in codonMap {
			seq = seq.strReplace(codon + "|", aa + "|", { replaceAll: true, literal: true })
		}
		seq = seq.strReplace("\\|$", "", { replaceAll: false })
		seq = seq.strReplace("|", "", { replaceAll: true, literal: true })
		seq = seq.strReplace("[ACGT]{1,2}$", "", { replaceAll: true })
		return seq
	}


    filterSchema := [ { column: isOOFColumn, type: "String" }, { column: hasStopsColumn, type: "String" } ]
    if useStopCodonReplacement {
        filterSchema = append(filterSchema, { column: "nSeq" + featureForFlags, type: "String" })
    }

    // Marks each row of a filter TSV: __oof = 1 when out of frame, __stop = 1 when the
    // productive feature carries a stop codon (after the configured replacements).
    flagFilterRows := func(df) {
        stopExpr := pt.when(pt.col(hasStopsColumn).strToUpper().eq("TRUE")).then(pt.lit(1)).otherwise(pt.lit(0))
        if useStopCodonReplacement {
            translated := translateNtToAaExpr(pt.col("nSeq" + featureForFlags), codonMapReplace)
            stopExpr = pt.when(translated.strContains("*", { literal: true })).then(pt.lit(1)).otherwise(pt.lit(0))
        }
        return df.withColumns(
            pt.when(pt.col(isOOFColumn).strToUpper().eq("TRUE")).then(pt.lit(1)).otherwise(pt.lit(0)).alias("__oof"),
            stopExpr.alias("__stop")
        )
    }

    // Columns of the one-row per-sample table, besides sampleId. All Long.
    countColumns := [
        "exportedClonotypes",
        "readsUsedInClonotypesNew",
        "assemble.clonotypesDroppedByOutOfFrame",
        "assemble.clonotypesDroppedByStopCodons"
    ]
    for chain in chains {
        countColumns = append(countColumns, "clonotypesByChain." + chain)
        if isSingleCell {
            countColumns = append(countColumns, "assemble.clonotypesDroppedByOutOfFrameByChain." + chain)
            countColumns = append(countColumns, "assemble.clonotypesDroppedByStopCodonsByChain." + chain)
        }
    }
    if isSingleCell {
        countColumns = append(countColumns, "scCellsTotal", "scCellsBothChains", "exportedClonotypesPaired")
        for chain in chains {
            countColumns = append(countColumns, "clonotypesByChain." + chain + ".paired")
        }
    }

    sampleId := params.sampleId
    swf := pt.workflow().
        inMediumQueue().
        memFloor(PER_SAMPLE_COUNTS_MEM_FLOOR_GIB * units.GiB).
        cpu(PER_SAMPLE_COUNTS_CPU)

    row := flagFilterRows(swf.frame(filterTsv, { xsvType: "tsv", inferSchema: false, schema: filterSchema })).select(
        pt.lit(sampleId).alias("sampleId"),
        pt.col("__oof").sum().alias("assemble.clonotypesDroppedByOutOfFrame"),
        pt.col("__stop").sum().alias("assemble.clonotypesDroppedByStopCodons")
    )

    totalExpr := pt.lit(0)
    readsExpr := pt.lit(0)
    for chain in chains {
        chainCol := "clonotypesByChain." + chain
        readsCol := "__reads." + chain
        clonesFile := clonotypeTables[chain]
        if is_undefined(clonesFile) {
            row = row.withColumns(pt.lit(0).alias(chainCol), pt.lit(0).alias(readsCol))
        } else {
            chainCounts := swf.frame(clonesFile, { xsvType: "tsv", inferSchema: false, schema: [ { column: "readCount", type: "Double" } ] }).select(
                pt.lit(sampleId).alias("sampleId"),
                pt.col("clonotypeKey").count().alias(chainCol),
                pt.col("readCount").round().cast("Long").sum().alias(readsCol)
            )
            row = row.join(chainCounts, { how: "left", on: ["sampleId"] })
        }
        totalExpr = totalExpr.plus(pt.col(chainCol).fillNull(0))
        readsExpr = readsExpr.plus(pt.col(readsCol).fillNull(0))

        if isSingleCell {
            oofCol := "assemble.clonotypesDroppedByOutOfFrameByChain." + chain
            stopCol := "assemble.clonotypesDroppedByStopCodonsByChain." + chain
            chainFilterTsv := chainFilterTsvs[chain]
            if is_undefined(chainFilterTsv) {
                row = row.withColumns(pt.lit(0).alias(oofCol), pt.lit(0).alias(stopCol))
            } else {
                chainFilterCounts := flagFilterRows(swf.frame(chainFilterTsv, { xsvType: "tsv", inferSchema: false, schema: filterSchema })).select(
                    pt.lit(sampleId).alias("sampleId"),
                    pt.col("__oof").sum().alias(oofCol),
                    pt.col("__stop").sum().alias(stopCol)
                )
                row = row.join(chainFilterCounts, { how: "left", on: ["sampleId"] })
            }
        }
    }
    row = row.withColumns(
        totalExpr.alias("exportedClonotypes"),
        readsExpr.alias("readsUsedInClonotypesNew")
    )

    // Single-cell: cell pairing statistics for this sample from its single-cell chain
    // TSVs (cellKey, clonotypeKey per chain). A cell is paired when it carries more than
    // pairMinExclusive distinct chains: 2 for paired receptors, 1 for heavy-chain-only.
    if isSingleCell {
        scDfs := []
        if !is_undefined(scChainTsvs) {
            for chain in chains {
                scFile := scChainTsvs[chain]
                if is_undefined(scFile) {
                    continue
                }
                scDfs = append(scDfs, swf.frame(scFile, { xsvType: "tsv", inferSchema: false, schema: [ { column: "cellKey", type: "String" }, { column: "clonotypeKey", type: "String" } ] }).select(
                    pt.col("cellKey"),
                    pt.col("clonotypeKey"),
                    pt.lit(chain).alias("chain")
                ))
            }
        }
        if len(scDfs) == 0 {
            zeroExprs := [
                pt.lit(0).alias("scCellsTotal"),
                pt.lit(0).alias("scCellsBothChains"),
                pt.lit(0).alias("exportedClonotypesPaired")
            ]
            for chain in chains {
                zeroExprs = append(zeroExprs, pt.lit(0).alias("clonotypesByChain." + chain + ".paired"))
            }
            row = row.withColumns(zeroExprs...)
        } else {
            scAll := len(scDfs) > 1 ? pt.concat(scDfs) : scDfs[0]
            pairMinExclusive := scHeavyOnly ? 0 : 1
            pairedKeys := scAll.groupBy("cellKey").agg(pt.col("chain").nUnique().alias("_numChains")).
                filter(pt.col("_numChains").gt(pairMinExclusive)).
                select(pt.col("cellKey"))
            scPaired := scAll.join(pairedKeys, { how: "inner", on: ["cellKey"] })

            cellCounts := scAll.select(
                pt.lit(sampleId).alias("sampleId"),
                pt.col("cellKey").nUnique().alias("scCellsTotal")
            )
            pairedCellCounts := pairedKeys.select(
                pt.lit(sampleId).alias("sampleId"),
                pt.col("cellKey").count().alias("scCellsBothChains")
            )
            row = row.join(cellCounts, { how: "left", on: ["sampleId"] }).
                join(pairedCellCounts, { how: "left", on: ["sampleId"] })

            pairedTotalExpr := pt.lit(0)
            for chain in chains {
                colPaired := "clonotypesByChain." + chain + ".paired"
                if is_undefined(scChainTsvs[chain]) {
                    row = row.withColumns(pt.lit(0).alias(colPaired))
                } else {
                    chainPaired := scPaired.filter(pt.col("chain").eq(chain)).select(
                        pt.lit(sampleId).alias("sampleId"),
                        pt.col("clonotypeKey").nUnique().alias(colPaired)
                    )
                    row = row.join(chainPaired, { how: "left", on: ["sampleId"] })
                }
                pairedTotalExpr = pairedTotalExpr.plus(pt.col(colPaired).fillNull(0))
            }
            row = row.withColumns(pairedTotalExpr.alias("exportedClonotypesPaired"))
        }
    }

    selectExprs := [ pt.col("sampleId") ]
    for c in countColumns {
        selectExprs = append(selectExprs, pt.col(c).cast("Long"))
    }
    row.select(selectExprs...).save("counts.tsv")

    countsFile := swf.run().getFile("counts.tsv")

    return {
        counts: countsFile
    }
})
