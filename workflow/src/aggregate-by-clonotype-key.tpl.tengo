//tengo:hash_override 16C140BA-55E8-46E5-95B6-294A67C539A9

// Feeds :aggregate-by-clonotype-key-shards, which does the aggregation.
//
// The shard plan needs the number of clonotype rows over all input TSVs before the ptabler
// runs can be built. Counting is a command, and a template cannot read the result of a
// command it started itself, so this template counts and the shards template reads.
//
// The hash override changed with the split: the previous identity has failed runs recorded
// against it that must not be recovered.

ll := import("@platforma-sdk/workflow-tengo:ll")
self := import("@platforma-sdk/workflow-tengo:tpl")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
smart := import("@platforma-sdk/workflow-tengo:smart")
maps := import("@platforma-sdk/workflow-tengo:maps")

self.defineOutputs("tsv")

lineCounterSw := assets.importSoftware("@platforma-open/milaboratories.software-small-binaries:line-counter")
shardsTpl := assets.importTemplate(":aggregate-by-clonotype-key-shards")

// Same invocation as the SDK's exec.formula lineCount pre-exec: streaming binary, fixed small
// memory, light queue, 30-day input cache. Output is the number of newline characters.
countLines := func(fileRef) {
	fileName := "clonotypes.tsv"
	countOut := "linecount.txt"
	res := exec.builder().
		inLightQueue().
		cpu(1).
		mem("256MiB").
		software(lineCounterSw).
		addFile(fileName, fileRef).
		arg("--input").arg(fileName).
		arg("--output").arg(countOut).
		saveFileContent(countOut).
		cacheInputsDays(30).
		run()
	return res.getFileContent(countOut)
}

self.body(func(inputs) {
	inputData := inputs[pConstants.VALUE_FIELD_NAME]
	inputMap := inputData.inputs()
	ll.assert(len(inputMap) > 0, "no input files found")

	lineCounts := {}
	for sKey in maps.getKeys(inputMap) {
		lineCounts[sKey] = countLines(inputMap[sKey])
	}

	shardsInputs := {
		params: inputs.params,
		lineCounts: smart.createMapResource(lineCounts)
	}
	shardsInputs[pConstants.VALUE_FIELD_NAME] = inputData

	shards := render.create(shardsTpl, shardsInputs, {
		// Kept out of the deduplication key, the way process.tpl.tengo passes it to this
		// template: a run may be recovered across a change of the memory override.
		metaInputs: {
			perProcessMemGB: inputs.perProcessMemGB
		}
	})

	return {
		tsv: shards.output("tsv")
	}
})
