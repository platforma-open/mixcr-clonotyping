test := import("@platforma-sdk/workflow-tengo:test")
exec := import("@platforma-sdk/workflow-tengo:exec")
mf := import(":mem-formula")


f := exec.formula

_gib := func(n) { return n * 1073741824 }

// Evaluate a resource formula against a fake "reads" input of sizeBytes.
_eval := func(node, sizeBytes) {
	fileName := "input.fastq.gz"
	resolved := f.resolveAst(node, { "reads": [fileName] }, [fileName])
	resolver := {
		size:      func(files) { return sizeBytes },
		lineCount: func(files) { return 0 }
	}
	return f.evaluateResource(resolved, resolver, "test")
}

// Evaluate a resource formula against a fake ".clns" input of sizeBytes.
_evalClns := func(node, sizeBytes) {
	fileName := "clones.clns"
	resolved := f.resolveAst(node, { "clns": [fileName] }, [fileName])
	resolver := {
		size:      func(files) { return sizeBytes },
		lineCount: func(files) { return 0 }
	}
	return f.evaluateResource(resolved, resolver, "test")
}

// A large real input: the assemble-contigs floor (110 GiB) with 31.75 GiB of
// reads, so the data term 4 x size is exactly 127 GiB.
_READS_31_75_GIB := 34091302912

TestBaseMemGiBSelection := func() {
	test.isEqual(64,  mf.baseMemGiB(false, false, false))
	test.isEqual(110, mf.baseMemGiB(false, true, false))
	test.isEqual(110, mf.baseMemGiB(false, false, true))
	test.isEqual(192, mf.baseMemGiB(true, false, false))
	// mitool steps win over contigs/cells
	test.isEqual(192, mf.baseMemGiB(true, true, true))
}

TestMemFormula := func() {
	// mem = clamp(4 x size, base, 256 GiB). base is the lower bound, not a base to add to.

	// Reference input: 4 x 31.75 GiB = 127 GiB, above the 110 GiB floor.
	test.isEqual(_gib(127), _eval(mf.memFormula(110), _READS_31_75_GIB))

	// Empty input falls to the floor.
	test.isEqual(_gib(64),  _eval(mf.memFormula(64),  0))
	test.isEqual(_gib(110), _eval(mf.memFormula(110), 0))
	test.isEqual(_gib(192), _eval(mf.memFormula(192), 0))

	// 32 GiB of reads: the data term is 128 GiB and stands alone.
	test.isEqual(_gib(128), _eval(mf.memFormula(64),  _gib(32)))
	test.isEqual(_gib(128), _eval(mf.memFormula(110), _gib(32)))
	test.isEqual(_gib(192), _eval(mf.memFormula(192), _gib(32)))  // floor binds

	// The ceiling binds: 4 x 96 GiB = 384 GiB, clamped to 256.
	test.isEqual(_gib(256), _eval(mf.memFormula(64), _gib(96)))

	test.isEqual(_gib(110), f.fallbackOf(mf.memFormula(110)))
}

// A resolved preset bundle carrying only the clone-assembler parameters the sizing reads.
_presetWith := func(cloneAssemblerParameters) {
	return {
		pipeline: ["align", "assemble", "exportClones"],
		assemble: { cloneAssemblerParameters: cloneAssemblerParameters }
	}
}

TestAssemblingFeaturesTakesThePresetsOwnFeature := func() {
	// A kit preset sets its feature through SetClonotypeAssemblingFeatures and leaves the user
	// override undefined, so reading the override alone would size every such run as CDR3.
	test.isEqual(["VDJRegion"],
		mf.assemblingFeatures(_presetWith({ assemblingFeatures: ["VDJRegion"] }), undefined))
	test.isEqual(["{CDR1Begin:CDR3End}"],
		mf.assemblingFeatures(_presetWith({ assemblingFeatures: ["{CDR1Begin:CDR3End}"] }), undefined))
}

TestAssemblingFeaturesPrefersTheUserOverride := func() {
	test.isEqual(["CDR3"],
		mf.assemblingFeatures(_presetWith({ assemblingFeatures: ["VDJRegion"] }), "CDR3"))
}

TestAssemblingFeaturesFallsBackToCdr3WhenTheFieldIsFlagDriven := func() {
	// assemble-base leaves assemblingFeatures null; generic amplicon presets inherit that and
	// assemble by CDR3 unless a flag says otherwise.
	test.isEqual(["CDR3"], mf.assemblingFeatures(_presetWith({ assemblingFeatures: undefined }), undefined))
	test.isEqual(["CDR3"], mf.assemblingFeatures(_presetWith({}), undefined))
	test.isEqual(["CDR3"], mf.assemblingFeatures({}, undefined))
}


// An align report carrying the estimate of initialClonesCreated.
_alignReportWith := func(estimate) {
	return {
		totalReadsProcessed: 1000000,
		estimatedClonotypes: estimate
	}
}

TestAssembleEstimateReadsInitialClones := func() {
	report := _alignReportWith({
		assemblingFeatures: ["VDJRegion"], splitBy: ["Constant"], qualityThreshold: 15,
		initialClones: 182071, cdr3: 190000
	})
	test.isEqual(182071, mf.assembleEstimate(report))
}

TestAssembleEstimateIsUndefinedWhenTheFieldIsAbsent := func() {
	// The MiXCR pin that predates the sketch writes no estimatedClonotypes at all.
	test.isTrue(is_undefined(mf.assembleEstimate({ totalReadsProcessed: 1000000 })))
	test.isTrue(is_undefined(mf.assembleEstimate({ estimatedClonotypes: undefined })))
	test.isTrue(is_undefined(mf.assembleEstimate(undefined)))
	test.isTrue(is_undefined(mf.assembleEstimate(_alignReportWith({}))))
	test.isTrue(is_undefined(mf.assembleEstimate(_alignReportWith({ initialClones: -1 }))))
}

TestAssembleRamGiB := func() {
	// ram = clamp(ceil(1.35 x (7 + 10.8 x est_M)), 4 GiB, 256 GiB)
	test.isEqual(18,  mf.assembleRamGiB(550000))    // real phage, 0.55 M
	test.isEqual(67,  mf.assembleRamGiB(3930000))   // dense bulk, 3.93 M
	test.isEqual(223, mf.assembleRamGiB(14600000))
	// The cap binds: 20 M clones would ask for 301 GiB.
	test.isEqual(256, mf.assembleRamGiB(20000000))
	// The intercept holds the small end above the 4 GiB floor.
	test.isEqual(10,  mf.assembleRamGiB(0))
}

// Evaluate a resource formula against a fake ".vdjca" input of sizeBytes.
_evalVdjca := func(node, sizeBytes) {
	fileName := "aligned.vdjca"
	resolved := f.resolveAst(node, { "vdjca": [fileName] }, [fileName])
	resolver := {
		size:      func(files) { return sizeBytes },
		lineCount: func(files) { return 0 }
	}
	return f.evaluateResource(resolved, resolver, "test")
}

TestAssembleFallbackRam := func() {
	// ram = clamp(ceil(4 GiB + 21.9 x size(vdjca)), 64 GiB, 256 GiB), whole GiB.
	test.isEqual(_gib(64),  _evalVdjca(mf.assembleFallbackRam(), 0))
	test.isEqual(_gib(64),  _evalVdjca(mf.assembleFallbackRam(), _gib(2)))
	// The dense 7.39 M-clone library: .vdjca 5.05 GiB, bisected floor 80 GiB.
	// 4 + 21.9 x 5.05 = 114.6, rounded up to 115.
	test.isEqual(_gib(115), _evalVdjca(mf.assembleFallbackRam(), _gib(505) / 100))
	// 4 + 21.9 x 8 = 179.2, rounded up to 180.
	test.isEqual(_gib(180), _evalVdjca(mf.assembleFallbackRam(), _gib(8)))
	test.isEqual(_gib(256), _evalVdjca(mf.assembleFallbackRam(), _gib(12)))
	test.isEqual(_gib(64),  f.fallbackOf(mf.assembleFallbackRam()))
}

TestExportRam := func() {
	// ram = clamp(8 GiB + perByte x size(clns), floor, 256 GiB)

	// The floor carries an empty or small .clns. At perByte 32 it binds up to 0.25 GiB.
	test.isEqual(_gib(16), _evalClns(mf.exportRam(undefined, 16, 32), 0))
	test.isEqual(_gib(24), _evalClns(mf.exportRam(undefined, 24, 32), 0))
	test.isEqual(_gib(16), _evalClns(mf.exportRam(undefined, 16, 32), _gib(1) / 4))

	// Above the floor, the fitted term stands alone. perByte is 30 for a bulk export on
	// `memory-from-limits`, which is what every caller ships. 32 covers two other cases:
	// the `main` entrypoint (-XX:MaxRAMPercentage=80.0), and mixcr-export's single-cell
	// export, where it pays for the divideClonesByTags expansion instead.
	test.isEqual(_gib(40), _evalClns(mf.exportRam(undefined, 16, 32), _gib(1)))
	test.isEqual(_gib(38), _evalClns(mf.exportRam(undefined, 16, 30), _gib(1)))
	test.isEqual(_gib(72), _evalClns(mf.exportRam(undefined, 16, 32), _gib(2)))

	// Regression guard at the values the QC exports ship: a 1 GiB .clns needs more than the
	// flat 16 GiB those exports requested before they were sized from the file.
	test.isTrue(_evalClns(mf.exportRam(undefined, 24, 30), _gib(1)) > _gib(16))

	// The QC export floor is 24, not 16. Below a 23 GiB grant memory-from-limits binds on
	// `grant - 3500 MiB`, which is under the 0.85 that perByte 30 is fitted to, so a 16 GiB
	// floor under-serves a .clns of 0.25 to 0.38 GiB. 24 GiB grants 20.4 GiB of heap, above
	// the 20.0 GiB that 0.35 GiB of .clns needs by the fit.
	test.isEqual(_gib(24), _evalClns(mf.exportRam(undefined, 24, 30), _gib(35) / 100))

	// The ceiling binds.
	test.isEqual(_gib(256), _evalClns(mf.exportRam(undefined, 16, 32), _gib(8)))

	// The Advanced Settings override raises the floor. It does not replace the rule.
	test.isEqual(_gib(48), _evalClns(mf.exportRam(48, 16, 32), 0))
	test.isEqual(_gib(48), f.fallbackOf(mf.exportRam(48, 16, 32)))
	// The data term still applies above the raised floor: 8 + 32 x 2 = 72.
	test.isEqual(_gib(72), _evalClns(mf.exportRam(48, 16, 32), _gib(2)))
	// An override below the floor has no effect. Before this change the override replaced
	// the rule outright, so whatever a project set was what every export asked for.
	test.isEqual(_gib(16), _evalClns(mf.exportRam(5, 16, 32), 0))
	test.isEqual(_gib(40), _evalClns(mf.exportRam(5, 16, 32), _gib(1)))
	test.isEqual(_gib(24), _evalClns(mf.exportRam(5, 24, 32), 0))

	// An override ABOVE the 256 GiB cap raises the cap. Leaving the cap where it is would
	// give between() lo > hi, which it asserts against. 400 is a real configured value.
	test.isEqual(_gib(400), _evalClns(mf.exportRam(400, 16, 30), _gib(1)))
	test.isEqual(_gib(400), _evalClns(mf.exportRam(400, 16, 30), 0))
	test.isEqual(_gib(400), f.fallbackOf(mf.exportRam(400, 16, 30)))
	// At the cap exactly, nothing changes.
	test.isEqual(_gib(256), _evalClns(mf.exportRam(256, 16, 30), 0))

	// Backends that cannot evaluate formulas fall back to the floor.
	test.isEqual(_gib(16), f.fallbackOf(mf.exportRam(undefined, 16, 32)))
	test.isEqual(_gib(24), f.fallbackOf(mf.exportRam(undefined, 24, 32)))
}

TestRefineRam := func() {
	// ram = min(ceil(6 GiB + 2.1 x size(vdjca)), 256 GiB), whole GiB.
	test.isEqual(_gib(7),   _evalVdjca(mf.refineRam(), _gib(39) / 100))
	test.isEqual(_gib(24),  _evalVdjca(mf.refineRam(), _gib(813) / 100))
	test.isEqual(_gib(27),  _evalVdjca(mf.refineRam(), _gib(954) / 100))
	test.isEqual(_gib(6),   _evalVdjca(mf.refineRam(), 0))
	test.isEqual(_gib(256), _evalVdjca(mf.refineRam(), _gib(200)))
	test.isEqual(_gib(64),  f.fallbackOf(mf.refineRam()))
}

TestUmiAssembleRam := func() {
	// ram = clamp(ceil(0.86 x size(vdjca)), 16 GiB, 256 GiB), whole GiB.
	test.isEqual(_gib(16),  _evalVdjca(mf.umiAssembleRam(), _gib(1)))
	test.isEqual(_gib(16),  _evalVdjca(mf.umiAssembleRam(), _gib(186) / 10))
	test.isEqual(_gib(26),  _evalVdjca(mf.umiAssembleRam(), _gib(30)))
	test.isEqual(_gib(256), _evalVdjca(mf.umiAssembleRam(), _gib(400)))
	test.isEqual(_gib(64),  f.fallbackOf(mf.umiAssembleRam()))
}

TestCellAssembleRam := func() {
	// ram = clamp(ceil(4.1 x size(vdjca)), 16 GiB, 256 GiB), whole GiB.
	test.isEqual(_gib(16),  _evalVdjca(mf.cellAssembleRam(), _gib(1)))
	test.isEqual(_gib(16),  _evalVdjca(mf.cellAssembleRam(), _gib(39) / 10))
	test.isEqual(_gib(41),  _evalVdjca(mf.cellAssembleRam(), _gib(10)))
	test.isEqual(_gib(256), _evalVdjca(mf.cellAssembleRam(), _gib(100)))
	test.isEqual(_gib(64),  f.fallbackOf(mf.cellAssembleRam()))
}

TestHasCellTag := func() {
	_withPattern := func(p) { return { align: { tagPattern: p } } }
	test.isTrue(mf.hasCellTag(_withPattern("^(CELL1:N{9})aatg(CELL2:N{9})ccac(CELL3:N{9})(UMI:N{8})\\^(R2:*)")))
	test.isTrue(mf.hasCellTag(_withPattern("^(CELL:N{16})(UMI:N{12})\\^(R2:*)")))
	test.isFalse(mf.hasCellTag(_withPattern("^N{0:2}(UMI:N{12})\\^(R2:*)")))
	test.isFalse(mf.hasCellTag(_withPattern("^(R1:*)\\^(R2:*)")))
	test.isFalse(mf.hasCellTag({ align: {} }))
	test.isFalse(mf.hasCellTag({}))
	test.isFalse(mf.hasCellTag(undefined))
}
