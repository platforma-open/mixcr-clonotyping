// Identity of this template for the platform's deduplication. Changing this value means
// "re-run every sample on the next block update" — see the longer note in :mixcr-analyze.
// Fresh here because this template is new; it must never equal the one another template uses,
// as a shared value declares two templates interchangeable.
//tengo:hash_override DEAB8EEB-E779-4B7D-A213-E3D1D460C076

// Runs `mixcr assemble` and `mixcr qc` on an aligned sample, sized from the align report.
//
// A template cannot read the result of a command it started, so the align run lives in
// :run-mixcr and this template only reads back what it wrote: the decoded align report picks
// the memory grant, and the aligned file is the input. Same split as :mixcr-analyze /
// :run-mixcr use for the read statistics.
//
// `qc` is here because `analyze` appends it at runtime whenever the preset carries qc checks,
// and it is in no preset pipeline. Dropping it would empty outputs.qc and kill the QC tab.

self := import("@platforma-sdk/workflow-tengo:tpl")
smart := import("@platforma-sdk/workflow-tengo:smart")
exec := import("@platforma-sdk/workflow-tengo:exec")
ll := import("@platforma-sdk/workflow-tengo:ll")
assets := import("@platforma-sdk/workflow-tengo:assets")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
times := import("times")
memf := import(":mem-formula")

self.defineOutputs("qc", "reports", "log", "qcLog", "clns")

mixcrSw := assets.importSoftware("@platforma-open/milaboratories.software-mixcr:memory-from-limits")

progressPrefix := "[==PROGRESS==]"

// `mixcr qc` reads the reports in the .clns footer; it holds no clones. The grant is a flat
// small number rather than a rule. NEEDS VERIFICATION: no bisected floor for `qc` exists.
QC_MEM := "4GiB"

VDJCA_FILE := "aligned.vdjca"

self.body(func(inputs) {
	vdjca := inputs.vdjca
	alignReport := inputs.alignReport
	clnsFileName := inputs.clnsFileName
	reports := inputs.reports
	assemblingFeatures := inputs.assemblingFeatures
	splitsClones := inputs.splitsClones
	baseMemGiB := inputs.baseMemGiB
	scratchFreeSpace := inputs.scratchFreeSpace
	perProcessMemGB := inputs.perProcessMemGB
	perProcessCPUs := inputs.perProcessCPUs

	qcTxtFile := "result.qc.txt"
	qcJsonFile := "result.qc.json"

	assembleReportJson := "result.assemble.report.json"
	assembleReportTxt := "result.assemble.report.txt"

	// The align report arrives as saved file content, so it decodes here. Anything unreadable
	// leaves the estimate undefined and selects the fallback rule — the same shape
	// :read-stats uses for a measurement it cannot use.
	//
	// A preset that splits clones by V, J or C gene takes the fallback rule too: the sketch
	// counts distinct assembling-feature sequences, which is a lower bound on the clone count
	// once the gene splits multiply it.
	estimatedClonotypes := undefined
	if !splitsClones {
		decodedAlignReport := undefined
		if smart.isResource(alignReport) {
			decodedAlignReport = alignReport.getDataAsJson()
		}
		estimatedClonotypes = memf.assembleEstimate(decodedAlignReport, assemblingFeatures)
	}

	assembleResources := { cpu: is_undefined(perProcessCPUs) ? 16 : perProcessCPUs }
	if !is_undefined(perProcessMemGB) {
		// memory per process was set in "Advanced Settings" block directly
		assembleResources.ram = string(perProcessMemGB) + "GiB"
	} else if !is_undefined(estimatedClonotypes) {
		assembleResources.ram = string(memf.assembleRamGiB(estimatedClonotypes)) + "GiB"
	} else {
		assembleResources.ram = memf.assembleFallbackRam(baseMemGiB)
	}
	if !is_undefined(scratchFreeSpace) {
		assembleResources.scratchFreeSpace = scratchFreeSpace
	}

	// The clone-clustering overrides are not repeated here: `align` wrote the resolved
	// parameter bundle into the .vdjca header and `assemble` reads it from there.
	// `mixcr assemble` takes no -M option of its own (GenericMiXCRMixins is declared on
	// analyze, align and exportPreset only), so the overrides can only go on align.
	assembleCmd := exec.builder().
		printErrStreamToStdout().
		saveStdoutStream().
		env("MI_USE_SYSTEM_CA", "true").
		env("MI_PROGRESS_PREFIX", progressPrefix).
		software(mixcrSw).
		secret("MI_LICENSE", "MI_LICENSE").
		env("MI_LICENSE_DEBUG", "MI_LICENSE_DEBUG").
		arg("assemble").
		arg("-f").
		arg("--report").arg(assembleReportTxt).
		arg("--json-report").arg(assembleReportJson).
		addFile(VDJCA_FILE, vdjca, { tag: "vdjca" }).
		arg(VDJCA_FILE).
		arg(clnsFileName).
		resources({ onCPU: assembleResources }).
		saveFile(clnsFileName).
		saveFile(assembleReportJson).
		saveFile(assembleReportTxt).
		cache(48 * times.hour).
		run()

	clnsFile := assembleCmd.getFile(clnsFileName)

	// One invocation writes both report formats: the command takes 0..2 output paths and
	// picks the writer by extension.
	//
	// stderr is merged into stdout and the stream is saved, so the log column carries this
	// command's failure text like every other step's.
	qcMem := QC_MEM
	if !is_undefined(perProcessMemGB) {
		// memory per process was set in "Advanced Settings" block directly
		qcMem = string(perProcessMemGB) + "GiB"
	}

	qcCmd := exec.builder().
		printErrStreamToStdout().
		saveStdoutStream().
		env("MI_USE_SYSTEM_CA", "true").
		software(mixcrSw).
		secret("MI_LICENSE", "MI_LICENSE").
		env("MI_LICENSE_DEBUG", "MI_LICENSE_DEBUG").
		arg("qc").
		arg("--print-to-stdout").
		arg("-f").
		addFile(clnsFileName, clnsFile).
		arg(clnsFileName).
		arg(qcTxtFile).
		arg(qcJsonFile).
		inLightQueue().
		cpu(1).
		mem(qcMem).
		saveFile(qcJsonFile).
		cache(48 * times.hour).
		run()

	// The align pair arrives as resources because the command that wrote it ran elsewhere;
	// the assemble pair comes straight off this template's own command.
	reportsMap := pcolumn.resourceMapBuilder( /* keyLength */ 2 )
	for report in reports {
		if report.id == "align" {
			reportsMap.add([report.id, "json"], inputs.alignReportJson)
			reportsMap.add([report.id, "txt"], inputs.alignReportTxt)
		} else if report.id == "assemble" {
			reportsMap.add([report.id, "json"], assembleCmd.getFile(assembleReportJson))
			reportsMap.add([report.id, "txt"], assembleCmd.getFile(assembleReportTxt))
		} else {
			ll.panic("unexpected report id %v", report.id)
		}
	}

	return {
		qc: qcCmd.getFile(qcJsonFile),
		log: assembleCmd.getStdoutStream(),
		qcLog: qcCmd.getStdoutStream(),
		reports: reportsMap.build(),
		clns: clnsFile
	}
})
