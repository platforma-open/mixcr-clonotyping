// Turns a resolved preset into the list of per-step commands a split run executes, and the class
// :resources sizes them by, or 'undefined' when the pipeline carries a step the split does not
// know, and the run stays one `analyze` command.
//
// The plan reads only the resolved bundle `mixcr exportPreset` writes, so a preset from a file
// is planned the same way as a built-in one.
//
// Shape of a pipeline the split takes:
//   - optional MiTool steps first, starting with `mitool-parse`;
//   - then `align`;
//   - then any of refineTagsAndSort, assemblePartial, extend, assemble, assembleContigs,
//     assembleCells, in an order whose file types chain;
//   - exportClones and exportCloneGroups anywhere after `align`. They are dropped: the block
//     saves nothing from them, and they read a file without changing it.
//
// The last step must write a .clns, and `assemble` must be present. The preset must carry qc
// checks, and no step may split the reads by sample.

text := import("text")

// The file the last step writes.
CLNS_FILE_NAME := "result.clns"

_EXPORT_STEPS := { exportClones: true, exportCloneGroups: true }

// Input and output file type of each chain step. "same" keeps the input's type.
_CHAIN_STEPS := {
	refineTagsAndSort: { from: ["vdjca"], out: "vdjca" },
	assemblePartial: { from: ["vdjca"], out: "vdjca" },
	extend: { from: ["vdjca", "clns"], out: "same" },
	assemble: { from: ["vdjca"], out: "assemble" },
	assembleContigs: { from: ["clna"], out: "clns" },
	assembleCells: { from: ["clns"], out: "clns" }
}

// MiXCR's run order of each step the split knows, from the `order` of each command descriptor in
// mixcr-algo `MiXCRCommandDescriptor.kt`. `analyze` sorts the pipeline by these values, so the
// plan does too, whatever order the preset lists its steps in.
_STEP_ORDER := {
	"mitool-parse": -1000,
	"mitool-refine-tags": -900,
	"mitool-consensus": -800,
	align: 0,
	refineTagsAndSort: 100,
	assemblePartial: 300,
	extend: 400,
	assemble: 500,
	assembleContigs: 600,
	assembleCells: 650,
	exportClones: 700,
	exportCloneGroups: 800
}

// _sortByStepOrder returns the steps in MiXCR's run order, or 'undefined' when one has no order.
_sortByStepOrder := func(steps) {
	sorted := []
	for step in steps {
		order := _STEP_ORDER[step]
		if is_undefined(order) {
			return undefined
		}
		// Stable insertion: the new step goes after every step whose order is not greater.
		next := []
		placed := false
		for s in sorted {
			if !placed && _STEP_ORDER[s] > order {
				next = append(next, step)
				placed = true
			}
			next = append(next, s)
		}
		if !placed {
			next = append(next, step)
		}
		sorted = next
	}
	return sorted
}

_MITOOL_COMMANDS := {
	"mitool-parse": "parse",
	"mitool-refine-tags": "refine-tags",
	"mitool-consensus": "consensus"
}

_contains := func(list, value) {
	for v in list {
		if v == value {
			return true
		}
	}
	return false
}

// hasCellTag reports whether the resolved preset's tag pattern captures a cell barcode (CELL,
// CELL1, CELL2, ...). `mixcr exportPreset` applies the user's --tag-pattern before writing the
// bundle, so `align.tagPattern` is the pattern the run aligns with.
hasCellTag := func(presetContent) {
	if !is_map(presetContent) || !is_map(presetContent.align) {
		return false
	}
	tagPattern := presetContent.align.tagPattern
	if !is_string(tagPattern) {
		return false
	}
	return text.contains(tagPattern, "(CELL")
}

// hasLongReadAligner reports whether the resolved preset aligns with the long-read aligner:
// only presets built on `align-long-read` carry `align.parameters.longReadsParameters`.
hasLongReadAligner := func(presetContent) {
	if !is_map(presetContent) || !is_map(presetContent.align) || !is_map(presetContent.align.parameters) {
		return false
	}
	return is_map(presetContent.align.parameters.longReadsParameters)
}

// _hasSampleTag reports whether a tag pattern names a sample tag: MiTool takes every tag whose
// name starts with "S" as one (mitool `TagType.inferType`).
_hasSampleTag := func(pattern) {
	if !is_string(pattern) {
		return false
	}
	for match in text.re_find("\\(([A-Za-z][A-Za-z0-9_]*):", pattern, -1) {
		if text.has_prefix(text.to_upper(match[1].text), "S") {
			return true
		}
	}
	return false
}

// splitsBySample reports whether `mitool parse` or `align` writes one file per sample: the step
// has splitBySample set, MiXCR's default, and its tag pattern names a sample tag. The split
// rejects these runs.
splitsBySample := func(presetContent) {
	if !is_map(presetContent) {
		return false
	}
	mitool := is_map(presetContent.mitool) ? presetContent.mitool.parse : undefined
	if is_map(mitool) && mitool.splitBySample != false && _hasSampleTag(mitool.pattern) {
		return true
	}
	align := presetContent.align
	return is_map(align) && align.splitBySample != false && _hasSampleTag(align.tagPattern)
}

// hasQcChecks reports whether the preset carries qc checks. `analyze` runs `qc` only then, and the
// split rejects a run without them.
hasQcChecks := func(presetContent) {
	return is_map(presetContent) && is_map(presetContent.qc) && is_array(presetContent.qc.checks) &&
		len(presetContent.qc.checks) > 0
}

// _mitoolSteps lists the MiTool commands in run order: [{ step, command, logKey, outName }].
// Each `consensus` round is its own command. 'undefined' when the MiTool part is malformed.
_mitoolSteps := func(presetContent, names) {
	steps := []
	for i, name in names {
		command := _MITOOL_COMMANDS[name]
		if is_undefined(command) || (i == 0) != (name == "mitool-parse") {
			return undefined
		}
		if command != "consensus" {
			steps = append(steps, { step: name, command: command, logKey: name, outName: command + ".mic" })
			continue
		}
		rounds := is_map(presetContent.mitool) ? presetContent.mitool.consensus : undefined
		if !is_array(rounds) || len(rounds) == 0 {
			return undefined
		}
		for r := 1; r <= len(rounds); r++ {
			steps = append(steps, {
				step: name,
				command: command,
				logKey: name + "." + string(r),
				outName: command + "." + string(r) + ".mic"
			})
		}
	}
	return steps
}

// stepClass names the class :resources sizes a run's steps by, first match winning: "longRead"
// for the long-read aligner, "cell" when the tag pattern captures a cell barcode or the pipeline
// assembles cells, "umi" when it refines tags, and "none" otherwise.
stepClass := func(presetContent) {
	if hasLongReadAligner(presetContent) {
		return "longRead"
	}
	pipeline := is_map(presetContent) && is_array(presetContent.pipeline) ? presetContent.pipeline : []
	if hasCellTag(presetContent) || _contains(pipeline, "assembleCells") {
		return "cell"
	}
	if _contains(pipeline, "refineTagsAndSort") {
		return "umi"
	}
	return "none"
}

// plan returns { class, mitool: [...], align, chain: [...], qc }, or 'undefined'. Every step is
// { step, logKey, ... }: `step` is its :resources row, the chain links add outName, the MiTool
// steps add command and outName.
plan := func(presetContent) {
	if !is_map(presetContent) || !is_array(presetContent.pipeline) {
		return undefined
	}
	if splitsBySample(presetContent) || !hasQcChecks(presetContent) {
		return undefined
	}
	pipeline := _sortByStepOrder(presetContent.pipeline)
	if is_undefined(pipeline) {
		return undefined
	}

	alignAt := -1
	for i, step in pipeline {
		if step == "align" {
			alignAt = i
			break
		}
	}
	if alignAt < 0 {
		return undefined
	}

	mitool := _mitoolSteps(presetContent, pipeline[:alignAt])
	if is_undefined(mitool) {
		return undefined
	}

	chainSteps := []
	for step in pipeline[alignAt + 1:] {
		if !_EXPORT_STEPS[step] {
			chainSteps = append(chainSteps, step)
		}
	}

	assemblePartialRounds := 1
	if is_map(presetContent.assemblePartial) {
		repeats := int(presetContent.assemblePartial.repeats)
		if !is_undefined(repeats) && repeats > 1 {
			assemblePartialRounds = repeats
		}
	}
	clnaOutput := is_map(presetContent.assemble) && presetContent.assemble.clnaOutput == true

	links := []
	kind := "vdjca"
	hasAssemble := false
	for step in chainSteps {
		def := _CHAIN_STEPS[step]
		if is_undefined(def) || !_contains(def.from, kind) {
			return undefined
		}
		if def.out == "assemble" {
			kind = clnaOutput ? "clna" : "clns"
			hasAssemble = true
		} else if def.out != "same" {
			kind = def.out
		}

		rounds := step == "assemblePartial" ? assemblePartialRounds : 1
		for r := 1; r <= rounds; r++ {
			suffix := rounds > 1 ? "." + string(r) : ""
			links = append(links, {
				step: step,
				logKey: step + suffix,
				outName: step + suffix + "." + kind
			})
		}
	}
	if !hasAssemble || kind != "clns" {
		return undefined
	}
	last := links[len(links) - 1]
	last.outName = CLNS_FILE_NAME

	// Log keys lead with the run position, zero-padded, so the step that has got furthest sorts
	// last and the UI needs no list of steps.
	align := { step: "align", logKey: "align" }
	qc := { step: "qc", logKey: "qc" }
	position := 0
	for step in append(append(append(mitool, align), links...), qc) {
		position++
		step.logKey = (position < 10 ? "0" : "") + string(position) + ":" + step.logKey
	}

	return { class: stepClass(presetContent), mitool: mitool, align: align, chain: links, qc: qc }
}

export {
	plan: plan,
	stepClass: stepClass,
	splitsBySample: splitsBySample,
	hasQcChecks: hasQcChecks,
	hasCellTag: hasCellTag,
	hasLongReadAligner: hasLongReadAligner
}
