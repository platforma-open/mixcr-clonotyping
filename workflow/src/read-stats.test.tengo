test := import("@platforma-sdk/workflow-tengo:test")
exec := import("@platforma-sdk/workflow-tengo:exec")
rs := import(":read-stats")

f := exec.formula

// The largest volume EBS gp3 can create, and what AWS deployments configure as
// --k8s-max-scratch-request. A request above it is clamped, so the run would get less space
// than it was sized for without anything saying so.
_CEILING_GIB := 16 * 1024

_GIB := 1024 * 1024 * 1024

// The scratch request, in whole GiB, for the metrics the collector would write. The formula
// is evaluated as the platform evaluates it, against a resolver that answers the collector's
// metrics from `metrics` instead of running it.
_scratchGiB := func(metrics) {
	stats := f.collector("readStats", {
		metrics: rs.METRICS,
		files: { "input_R1.fastq.gz": "r1" },
		builder: func(files) { return undefined }
	})
	resolved := f.resolveAst(rs.scratchFormula(stats), {}, [])
	resolver := {
		size: func(files) { return 0 },
		lineCount: func(files) { return 0 },
		custom: func(node) { return metrics[node.name] }
	}
	bytes := f.evaluateScratch(resolved, resolver)
	test.isEqual(0, bytes % _GIB, "the request is a whole number of GiB")
	return bytes / _GIB
}

// A paired sample of uniform read length: the metrics jq folds one file per end into.
_paired := func(numberOfReads, readLength) {
	return { reads: numberOfReads, basesR1: numberOfReads * readLength, basesR2: numberOfReads * readLength, longestRead: readLength }
}

TestVolumeTermWins := func() {
	// The reference sample: 72,604,410 pairs of 151 bp.
	//   S = 4.0 x 72.60441 x 302/1000     = 87.71 GiB
	//   C = 11  x 72.60441 x (0.151)^2    = 18.21 GiB
	test.isEqual(88, _scratchGiB(_paired(72604410, 151)))
}

TestLengthTermWins := func() {
	// Long reads make the quadratic term overtake the volume term.
	//   S = 4.0 x 1.0 x 4000/1000         = 16.00 GiB
	//   C = 11  x 1.0 x (2.0)^2           = 44.00 GiB
	test.isEqual(44, _scratchGiB(_paired(1000000, 2000)))
}

TestSingleEndUsesOneLength := func() {
	// Only R1 present, so 'lengthOfR2' contributes nothing.
	//   S = 4.0 x 72.60441 x 151/1000     = 43.85 GiB
	//   C = 18.21 GiB
	test.isEqual(44, _scratchGiB({ reads: 72604410, basesR1: 72604410 * 151, basesR2: 0, longestRead: 151 }))
}

TestLongestReadDecides := func() {
	// R2 holds the longest read, and it is the term that decides; jq takes the longest read
	// across both ends.
	//   C = 11 x 1.0 x (2.0)^2 = 44.00 GiB
	test.isEqual(44, _scratchGiB({ reads: 1000000, basesR1: 100000000, basesR2: 100000000, longestRead: 2000 }))
}

TestSmallSampleRoundsUpToOneGiB := func() {
	// Below a whole GiB, but a sample that small still needs scratch space.
	test.isEqual(1, _scratchGiB(_paired(10000, 151)))
	// Nothing measured at all still asks for the floor, not for zero.
	test.isEqual(1, _scratchGiB({ reads: 0, basesR1: 0, basesR2: 0, longestRead: 0 }))
}

TestLargeSingleEndSampleStaysUnderTheCeiling := func() {
	// The largest shape we expect: 600M single-end reads of 1000 bp. The quadratic term
	// decides, and this is where it would run away if it were going to.
	//   S = 4.0 x 600 x 1000/1000  = 2400 GiB
	//   C = 11  x 600 x (1.0)^2    = 6600 GiB
	gib := _scratchGiB({ reads: 600000000, basesR1: 600000000 * 1000, basesR2: 0, longestRead: 1000 })
	test.isEqual(6600, gib)
	test.isTrue(gib < _CEILING_GIB, "%v GiB is at or above the %v GiB ceiling", gib, _CEILING_GIB)
}

TestHugeSampleDoesNotOverflow := func() {
	// 10^10 reads of 10^5 bases, far past any real sample: the read count enters the length
	// term in thousands, so the product (1.1 x 10^18) stays inside int64 and the result is the
	// float formula's.
	//   C = 11 x 10^4 x (100)^2 = 1.1 x 10^9 GiB
	test.isEqual(1100000000, _scratchGiB({ reads: 10000000000, basesR1: 0, basesR2: 0, longestRead: 100000 }))
}

TestIndexReadsAreNotMeasured := func() {
	reads := rs.readsToMeasure({
		"input_R1.fastq.gz": "r1",
		"input_R2.fastq.gz": "r2",
		"input_I1.fastq.gz": "i1",
		"input_L1_I2.fastq.gz": "i2"
	})
	test.isEqual({ "input_R1.fastq.gz": "r1", "input_R2.fastq.gz": "r2" }, reads)
	test.isEqual({ "input.fastq.gz": "r" }, rs.readsToMeasure({ "input.fastq.gz": "r" }))
}
