// Identity of this template for the platform's deduplication. While :mixcr-analyze, above this
// template, carries an override of its own, this value has no effect: rotate that one when
// the computation changes. It must never equal the one another template uses, as a
// shared value declares two templates interchangeable.
//tengo:hash_override 86FDD115-756E-49D5-9712-8DE4606C59B3

// Runs the steps of a split run after `align`, as :pipeline-plan lists them, then `mixcr qc`.
//
// A template cannot read the result of a command it started, and the bulk `assemble` grant is
// sized from the clone estimate in the align report, so `align` runs in :run-mixcr and this
// template reads back what it wrote.
//
// `qc` is here because `analyze` appends it at runtime whenever the preset carries qc checks,
// and it is in no preset pipeline. Dropping it would empty outputs.qc and kill the QC tab.

self := import("@platforma-sdk/workflow-tengo:tpl")
smart := import("@platforma-sdk/workflow-tengo:smart")
ll := import("@platforma-sdk/workflow-tengo:ll")
assets := import("@platforma-sdk/workflow-tengo:assets")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
times := import("times")
memf := import(":mem-formula")
mixcrCmd := import(":mixcr-cmd")

self.defineOutputs("qc", "reports", "log", "clns")

mixcrSw := assets.importSoftware("@platforma-open/milaboratories.software-mixcr:memory-from-limits")

CACHE_PERIOD := 48 * times.hour

// `mixcr qc` reads the reports in the .clns footer; it holds no clones, so the "Advanced
// Settings" memory override, which sizes the steps that do, does not apply to it. NEEDS
// VERIFICATION: no bisected floor for `qc` exists.
QC_MEM := "4GiB"

self.body(func(inputs) {
	reports := inputs.reports
	res := {
		perProcessMemGB: inputs.perProcessMemGB,
		perProcessCPUs: inputs.perProcessCPUs,
		scratchFreeSpace: inputs.scratchFreeSpace
	}

	// The align report arrives as saved file content, so it decodes here. Anything unreadable
	// leaves the estimate undefined, and the bulk `assemble` grant falls back to the .vdjca.
	decodedAlignReport := undefined
	if smart.isResource(inputs.alignReport) {
		decodedAlignReport = inputs.alignReport.getDataAsJson()
	}
	estimatedClonotypes := memf.assembleEstimate(decodedAlignReport)

	assembleReportJson := "result.assemble.report.json"
	assembleReportTxt := "result.assemble.report.txt"

	logs := pcolumn.resourceMapBuilder( /* keyLength */ 1 )

	// The clone-clustering overrides are not repeated on any step: `align` wrote the resolved
	// parameter bundle into the .vdjca header and every later step reads it from there.
	inName := "result.vdjca"
	inFile := inputs.vdjca
	assembleCmd := undefined
	for link in inputs.chain {
		cmd := mixcrCmd.builder(mixcrSw).arg(link.step).arg("-f")
		if link.step == "assemble" {
			cmd.arg("--report").arg(assembleReportTxt).
				arg("--json-report").arg(assembleReportJson).
				saveFile(assembleReportJson).
				saveFile(assembleReportTxt)
		}
		cmd.addFile(inName, inFile, { tag: memf.INPUT_TAG }).
			arg(inName).
			arg(link.outName).
			saveFile(link.outName)
		mixcrCmd.applyResources(cmd, memf.stepRam(link.grant, estimatedClonotypes), res)
		run := cmd.cache(CACHE_PERIOD).run()
		logs.add([link.logKey], run.getStdoutStream())

		if link.step == "assemble" {
			assembleCmd = run
		}
		inName = link.outName
		inFile = run.getFile(link.outName)
	}
	clnsFile := inFile

	// One invocation writes both report formats: the command takes 0..2 output paths and picks
	// the writer by extension.
	qcTxtFile := "result.qc.txt"
	qcJsonFile := "result.qc.json"
	qcCmd := mixcrCmd.builder(mixcrSw).
		arg("qc").
		arg("--print-to-stdout").
		arg("-f").
		addFile(inName, clnsFile).
		arg(inName).
		arg(qcTxtFile).
		arg(qcJsonFile).
		inLightQueue().
		cpu(1).
		mem(QC_MEM).
		saveFile(qcJsonFile).
		cache(CACHE_PERIOD).
		run()
	logs.add([inputs.qcLogKey], qcCmd.getStdoutStream())

	// The align pair arrives as resources because the command that wrote it ran in :run-mixcr.
	reportsMap := pcolumn.resourceMapBuilder( /* keyLength */ 2 )
	for report in reports {
		if report.id == "align" {
			reportsMap.add([report.id, "json"], inputs.alignReportJson)
			reportsMap.add([report.id, "txt"], inputs.alignReportTxt)
		} else if report.id == "assemble" {
			reportsMap.add([report.id, "json"], assembleCmd.getFile(assembleReportJson))
			reportsMap.add([report.id, "txt"], assembleCmd.getFile(assembleReportTxt))
		} else {
			ll.panic("unexpected report id %v", report.id)
		}
	}

	return {
		qc: qcCmd.getFile(qcJsonFile),
		log: logs.build(),
		reports: reportsMap.build(),
		clns: clnsFile
	}
})
