// Identity of this template for the platform's deduplication. While :mixcr-analyze, above this
// template, carries an override of its own, this value has no effect: rotate that one when
// the computation changes. It must never equal the one another template uses, as a
// shared value declares two templates interchangeable.
//tengo:hash_override 857A0480-F04D-4BAB-8697-E262BD515AD6

// Runs MiXCR on one measured sample.
//
// A pipeline :pipeline-plan accepts runs one exec per step, so each step carries its own memory
// grant instead of sharing the worst step's: the MiTool steps and `align` here, the rest and
// `qc` in :chain-mixcr, which can read the align report to size `assemble`. The in-chain
// `exportClones` and `exportCloneGroups` are dropped: the block saves nothing from them and
// re-exports from the .clns with its own argv in :mixcr-export.
//
// A pipeline :pipeline-plan rejects keeps the single `analyze` command.

self := import("@platforma-sdk/workflow-tengo:tpl")
smart := import("@platforma-sdk/workflow-tengo:smart")
render := import("@platforma-sdk/workflow-tengo:render")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
ll := import("@platforma-sdk/workflow-tengo:ll")
assets := import("@platforma-sdk/workflow-tengo:assets")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
times := import("times")
text := import("text")
maps := import("@platforma-sdk/workflow-tengo:maps")
memf := import(":mem-formula")
mixcrCmd := import(":mixcr-cmd")
readStats := import(":read-stats")
pipelinePlan := import(":pipeline-plan")

json := import("json")

self.defineOutputs("qc", "reports", "log", "clns")

mixcrSw := assets.importSoftware("@platforma-open/milaboratories.software-mixcr:memory-from-limits")
chainMixcrTpl := assets.importTemplate(":chain-mixcr")

CACHE_PERIOD := 48 * times.hour

self.body(func(inputs) {
	inputData := inputs[pConstants.VALUE_FIELD_NAME]
	aggregationAxesNames := inputs[pConstants.AGGREGATION_AXES_NAMES_FIELD_NAME]

	preset := inputs.preset
	library := inputs.library

	params := inputs.params
	species := params.species
	limitInput := params.limitInput
	leftAlignmentMode := params.leftAlignmentMode
	rightAlignmentMode := params.rightAlignmentMode
	materialType := params.materialType
	tagPattern := params.tagPattern
	assembleClonesBy := params.assembleClonesBy
	fileExtension := params.fileExtension
	reports := params.reports
	isLibraryFileGzipped := params.isLibraryFileGzipped

	presetContent := inputs.presetContent.getDataAsJson()

	if !is_map(presetContent) || !is_array(presetContent.pipeline) {
		ll.panic("malformed presetContent %v", presetContent)
	}

	inputDataMeta := inputData.getDataAsJson()

	// The "Advanced Settings" overrides, and the disposable disk space for MiXCR's temporary
	// files. TMPDIR points at a volume of that size, so MiXCR no longer writes temporary files
	// to the shared workspace storage. 'undefined' when :mixcr-analyze found no read end to
	// measure. One number covers every step of a split run: :read-stats folds the
	// sequence-volume and read-length terms into a single max, so the step that needs the
	// smaller of the two over-requests disk.
	res := {
		perProcessMemGB: inputs.perProcessMemGB,
		perProcessCPUs: inputs.perProcessCPUs,
		scratchFreeSpace: readStats.scratchFreeSpaceFor(inputs.readStats)
	}

	// Preset selection and every mixin that shapes the resolved parameter bundle. `align`
	// packs that bundle into the .vdjca header, and the later steps read it from there, so
	// this whole group belongs to the first command of the run whichever shape it takes.
	//
	// `analyze` takes the preset as its first positional; `align` takes it as `--preset`.
	// Every mixin below is an option on both, because align declares the same mixin groups
	// (AlignMiXCRMixins, AssembleMiXCRMixins, GenericMiXCRMixins) that analyze does.
	applyPresetArgs := func(builder, presetAsOption) {
		if library {
			builder.arg("--species").arg(species)
			if isLibraryFileGzipped {
				builder.arg("--library").arg("library.json.gz").
				addFile("library.json.gz", library)
			} else {
				builder.arg("--library").arg("library.json").
				addFile("library.json", library)
			}
		} else if !is_undefined(species) {
			builder.arg("--species").arg(species)
		}

		if presetAsOption {
			builder.arg("--preset")
		}
		if smart.isResource(preset) /* file */ {
			builder.
				arg("local#input_preset").
				addFile("input_preset.yaml", preset)
		} else {
			ll.assert(!is_undefined(preset.name), "undefined preset name")
			builder.
				arg(preset.name)
		}

		// Optional preset-specific parameters (order matters if preset requires positional values)
		if !is_undefined(leftAlignmentMode) {
			builder.arg(leftAlignmentMode)
		}
		if !is_undefined(rightAlignmentMode) {
			builder.arg(rightAlignmentMode)
		}
		if !is_undefined(materialType) {
			builder.arg(materialType)
		}
		if !is_undefined(tagPattern) {
			builder.arg("--tag-pattern").arg(tagPattern)
		}
		if !is_undefined(assembleClonesBy) {
			builder.arg("--assemble-clonotypes-by").arg(assembleClonesBy)
		}
		// Clone clustering tuning
		cloneClusteringMode := params.cloneClusteringMode
		if is_undefined(cloneClusteringMode) {
			cloneClusteringMode = "default"
		}
		if cloneClusteringMode == "relaxed" {
			builder.
				arg("-Massemble.cloneAssemblerParameters.minimalQuality=20").
				arg("-Massemble.cloneAssemblerParameters.badQualityThreshold=10").
				arg("-Massemble.cloneAssemblerParameters.cloneClusteringParameters.searchParameters=oneMismatchOrIndel").
				arg("-Massemble.cloneAssemblerParameters.cloneClusteringParameters.searchDepth=1")
		} else if cloneClusteringMode == "off" {
			builder.arg("-Massemble.cloneAssemblerParameters.cloneClusteringParameters=null")
		}
		return builder
	}

	// Stages the sample's read files and adds the positional pattern that names them.
	applyInputFiles := func(builder) {
		inputMap := inputData.inputs()
		if inputDataMeta.keyLength == 0 {
			ll.assert(aggregationAxesNames == [], "unexpected aggregation axes names")
			// Assuming only one key "[]" exists here, no need for sorted iteration
			inputFile := inputMap["[]"]
			ll.assert(!is_undefined(inputFile), "unexpected agg group structure")
			inputFileName := "input." + fileExtension
			builder.addFile(inputFileName, inputFile, { tag: "reads" })
			builder.arg(inputFileName)
		} else if inputDataMeta.keyLength == 1 {
			ll.assert(aggregationAxesNames == ["pl7.app/sequencing/readIndex"], "unexpected aggregation axes names")
			for sKey in maps.getKeys(inputMap) {
				inputFile := inputMap[sKey]
				key := json.decode(sKey)
				if len(key) != 1 {
					ll.panic("malformed key: %v", sKey)
				}
				r := key[0]
				if (r[0] != 'R' && r[0] != "I") || (r[1] != '1' && r[1] != '2') || len(r) != 2 {
					ll.panic("malformed read index: %v", r)
				}
				builder.addFile("input_" + r + "." + fileExtension, inputFile, { tag: "reads" })
			}
			builder.arg("input_{{R}}." + fileExtension)
		} else if inputDataMeta.keyLength == 2 {
			ll.assert(aggregationAxesNames == ["pl7.app/sequencing/lane", "pl7.app/sequencing/readIndex"], "unexpected aggregation axes names")
			for sKey in maps.getKeys(inputMap) {
				inputFile := inputMap[sKey]
				key := json.decode(sKey)
				if len(key) != 2 {
					ll.panic("malformed key: %v", sKey)
				}
				lane := key[0]
				r := key[1]
				if (r[0] != 'R' && r[0] != "I") || (r[1] != '1' && r[1] != '2') || len(r) != 2 {
					ll.panic("malformed read index: %v", r)
				}
				if is_undefined(int(lane)) {
					ll.panic("malformed lane: %v", lane)
				}
				builder.addFile("input_L" + lane + "_" + r + "." + fileExtension, inputFile, { tag: "reads" })
			}
			builder.arg("input_L{{n}}_{{R}}." + fileExtension)
		} else {
			ll.panic("too many axes / not supported")
		}
		return builder
	}

	// One stdout stream per command, keyed by the step that wrote it. `analyze` runs every
	// step in one JVM and contributes a single entry.
	logs := pcolumn.resourceMapBuilder( /* keyLength */ 1 )

	stepPlan := pipelinePlan.plan(presetContent)

	if is_undefined(stepPlan) {
		hasAssembleContigs := false
		hasAssembleCells := false
		hasMiToolSteps := false
		for stage in presetContent.pipeline {
			if stage == "assembleContigs" {
				hasAssembleContigs = true
			} else if stage == "assembleCells" {
				hasAssembleCells = true
			} else if text.has_prefix(stage, "mitool-") {
				hasMiToolSteps = true
			}
		}

		// `analyze` names its output after the last clns-writing step.
		clnsFileName := "result.clns"
		if hasAssembleContigs {
			clnsFileName = "result.contigs.clns"
		}
		if hasAssembleCells {
			clnsFileName = "result.assembledCells.clns"
		}

		mixcrCmdBuilder := mixcrCmd.builder(mixcrSw).arg("analyze")
		mixcrCmd.applyResources(mixcrCmdBuilder,
			memf.memFormula(memf.baseMemGiB(hasMiToolSteps, hasAssembleContigs, hasAssembleCells)), res)

		if !is_undefined(limitInput) {
			mixcrCmdBuilder.arg("--limit-input").arg(string(limitInput))
		}

		applyPresetArgs(mixcrCmdBuilder, false)
		applyInputFiles(mixcrCmdBuilder)

		mixcrCmdBuilder.arg("result")
		mixcrCmdBuilder.arg("--force-overwrite")

		mixcrCmdBuilder.saveFile("result.qc.json")
		mixcrCmdBuilder.saveFile(clnsFileName)

		for report in reports {
			mixcrCmdBuilder.saveFile(report.fileJson)
			mixcrCmdBuilder.saveFile(report.fileTxt)
		}

		mixcrRun := mixcrCmdBuilder.cache(CACHE_PERIOD).run()

		reportsMap := pcolumn.resourceMapBuilder( /* keyLength */ 2 )
		for report in reports {
			reportsMap.add([report.id, "json"], mixcrRun.getFile(report.fileJson))
			reportsMap.add([report.id, "txt"], mixcrRun.getFile(report.fileTxt))
		}

		logs.add(["analyze"], mixcrRun.getStdoutStream())

		return {
			qc: mixcrRun.getFile("result.qc.json"),
			log: logs.build(),
			reports: reportsMap.build(),
			clns: mixcrRun.getFile(clnsFileName)
		}
	}

	// MiTool steps: parse extracts the cell and UMI tags into a .mic, refine-tags corrects them
	// against the whitelists, and each consensus round collapses reads per tag group. Only parse
	// takes the preset. It packs the resolved MiTool parameters into the .mic header, and every
	// later step, `align` included, reads them from there.
	micFile := undefined
	micFileName := undefined
	for step in stepPlan.mitool {
		cmd := mixcrCmd.builder(mixcrSw).arg("mitool").arg(step.command)
		if step.command == "parse" {
			cmd.arg("--preset").arg("local:mitool_preset").
				writeFile("mitool_preset.yaml", presetContent.mitool)
			applyInputFiles(cmd)
		} else {
			cmd.addFile(micFileName, micFile, { tag: memf.INPUT_TAG }).arg(micFileName)
		}
		mixcrCmd.applyResources(cmd, memf.stepRam(step.grant), res)
		run := cmd.arg(step.outName).saveFile(step.outName).cache(CACHE_PERIOD).run()
		logs.add([step.logKey], run.getStdoutStream())
		micFileName = step.outName
		micFile = run.getFile(step.outName)
	}

	alignReportJson := "result.align.report.json"
	alignReportTxt := "result.align.report.txt"
	alignedFile := "result.vdjca"

	alignBuilder := mixcrCmd.builder(mixcrSw).arg("align").arg("-f")
	mixcrCmd.applyResources(alignBuilder, memf.stepRam("align"), res)

	// `--threads` exists on align alone of the MiXCR steps. Reading the granted count back from
	// the placeholder keeps the flag and the request from diverging.
	alignBuilder.arg("--threads").argExpr("{system.cpu}")

	if !is_undefined(limitInput) {
		alignBuilder.arg("--limit-input").arg(string(limitInput))
	}

	applyPresetArgs(alignBuilder, true)

	alignBuilder.
		arg("--report").arg(alignReportTxt).
		arg("--json-report").arg(alignReportJson)

	if is_undefined(micFile) {
		applyInputFiles(alignBuilder)
	} else {
		alignBuilder.addFile(micFileName, micFile).arg(micFileName)
	}

	// The report is saved twice: as a file, which is what the reports p-column carries, and
	// as content, which is the only form :chain-mixcr can decode to size `assemble`.
	alignRun := alignBuilder.
		arg(alignedFile).
		saveFile(alignedFile).
		saveFile(alignReportJson).
		saveFileContent(alignReportJson).
		saveFile(alignReportTxt).
		cache(CACHE_PERIOD).
		run()

	logs.add([stepPlan.align.logKey], alignRun.getStdoutStream())

	// The overrides go in as metaInputs, out of the deduplication key, for the same reason
	// :mixcr-analyze keeps them out of this template's: a run is recovered across a change of
	// the CPU or memory override. The scratch request never changes what a step produces.
	chainRun := render.create(
		chainMixcrTpl,
		{
			vdjca: alignRun.getFile(alignedFile),
			alignReport: alignRun.getFileContent(alignReportJson),
			alignReportJson: alignRun.getFile(alignReportJson),
			alignReportTxt: alignRun.getFile(alignReportTxt),
			chain: stepPlan.chain,
			qcLogKey: stepPlan.qc.logKey,
			reports: reports
		},
		{ metaInputs: res }
	)

	// The child's log map has one entry per chain step plus `qc`; each is lifted into this
	// template's map under the same key, so the UI sees every step's stream as it starts.
	chainLogs := chainRun.output("log", CACHE_PERIOD)
	for step in append(stepPlan.chain, stepPlan.qc) {
		logs.add([step.logKey], chainLogs.buildFutureField(string(json.encode([step.logKey]))))
	}

	return {
		qc: chainRun.output("qc", CACHE_PERIOD),
		log: logs.build(),
		reports: chainRun.output("reports", CACHE_PERIOD),
		clns: chainRun.output("clns", CACHE_PERIOD)
	}
})
