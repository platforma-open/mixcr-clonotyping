// The exec shape every MiXCR command of :run-mixcr shares.

exec := import("@platforma-sdk/workflow-tengo:exec")

PROGRESS_PREFIX := "[==PROGRESS==]"

// builder starts a MiXCR command: the MI_LICENSE secret, the system CA store and the progress
// prefix go in as environment variables, and stdout is saved with stderr merged in, so the log
// column carries the command's failure text.
builder := func(mixcrSw) {
	return exec.builder().
		printErrStreamToStdout().
		saveStdoutStream().
		env("MI_USE_SYSTEM_CA", "true").
		env("MI_PROGRESS_PREFIX", PROGRESS_PREFIX).
		software(mixcrSw).
		secret("MI_LICENSE", "MI_LICENSE").
		env("MI_LICENSE_DEBUG", "MI_LICENSE_DEBUG")
}

export {
	PROGRESS_PREFIX: PROGRESS_PREFIX,
	builder: builder
}
