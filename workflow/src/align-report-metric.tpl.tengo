// The custom metric template behind the clone sizing of :resources: reads the align report of one
// sample and writes the metrics the `assemble` memory formula uses, as one JSON object:
//
//     {"clones": 2227494, "aligned": 39375951, "hasEstimate": 1}
//
//   clones      - the report's estimatedInitialClones, 0 when it has none
//   aligned     - the report's aligned read count, 0 when it has none
//   hasEstimate - 1 when the report carries estimatedInitialClones, 0 otherwise; the formula
//                 then falls back to sizing from the step's input
//
// The platform runs this template before the step it sizes (exec.formula.customMetric).
//
// inputs.files: { <file name>: <file> } - the align JSON report, alone
// outputs.output: the JSON object

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")

times := import("times")

self.defineOutputs(["output"])

jqSw := assets.importSoftware("@platforma-open/milaboratories.software-binary-collection:jq")

// Matches the MiXCR run cache.
CACHE_PERIOD := 48 * times.hour

// jq emits floats as written; the formula takes non-negative integers only.
FOLD_PROGRAM := `{
    clones: (.estimatedInitialClones // 0 | floor),
    aligned: (.aligned // 0 | floor),
    hasEstimate: (if .estimatedInitialClones == null then 0 else 1 end)
  }`

self.body(func(inputs) {
	names := maps.getKeys(inputs.files)
	ll.assert(len(names) == 1, "expected the align report alone, got %v", names)

	fold := exec.builder().
		name("align report metrics").
		inLightQueue().
		cpu(1).
		mem("256MiB").
		software(jqSw).
		addFile("report.json", inputs.files[names[0]]).
		arg("--compact-output").
		arg(FOLD_PROGRAM).
		arg("report.json").
		saveStdoutContent().
		cache(CACHE_PERIOD).
		run()

	return { output: fold.getStdoutContent() }
})
