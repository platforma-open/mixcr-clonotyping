// Single source of truth for the `mixcr analyze` memory request.
//
//     mem = clamp(4 x size("reads"), baseMemGiB, 256 GiB)
//
// baseMemGiB is a TOTAL-memory value for the analysis, selected by which steps the
// preset runs, so it acts as the lower bound rather than a base to add data on top of.
// size("reads") is the stored (compressed) blob size of the sample's FASTQs, read from
// metadata with no pre-exec pass, so the formula resolves on backends that expose blob
// size and falls back to the bare floor on those that do not.

exec := import("@platforma-sdk/workflow-tengo:exec")

math := import("math")

f := exec.formula

// baseMemGiB picks the per-analysis memory floor from the preset's step set.
// mitool steps dominate; contig or cell assembly is the middle tier.
baseMemGiB := func(hasMiToolSteps, hasAssembleContigs, hasAssembleCells) {
	if hasMiToolSteps {
		return 192
	}
	if hasAssembleContigs || hasAssembleCells {
		return 110
	}
	return 64
}

// memFormula builds the fluent exec.formula node for `.resources({onCPU:{ram}})`.
// between() supplies `base` as the lower bound, so no explicit max() is needed.
memFormula := func(base) {
	return f.size("reads").times(4).
		between(f.gib(base), f.gib(256)).
		staticFallback(f.gib(base))
}

// grantGiBForXmx inverts the `memory-from-limits` entrypoint of software-mixcr, which sets
//
//     -Xmx = max(min(grant x 0.85, grant - 3500 MiB), grant x 0.50)
//
// so a step that needs a target heap must ask for the grant that produces it:
//
//     grant(X) = ceil(max(X / 0.85, X + 3500 MiB))
//
// The 0.85 arm binds above a 23.3 GiB grant, the additive arm from about 7 to 23.3 GiB. The
// entrypoint's `grant x 0.50` term only ever RAISES Xmx, so it needs no arm of its own.
_MIB_PER_GIB := 1024.0
_ENTRYPOINT_HEADROOM_MIB := 3500.0
_ENTRYPOINT_HEAP_FRACTION := 0.85

grantGiBForXmx := func(xmxGiB) {
	byFraction := xmxGiB / _ENTRYPOINT_HEAP_FRACTION
	byHeadroom := xmxGiB + _ENTRYPOINT_HEADROOM_MIB / _MIB_PER_GIB
	return int(math.ceil(math.max(byFraction, byHeadroom)))
}

// _cloneAssemblerParameters reads `assemble.cloneAssemblerParameters` out of the resolved
// preset bundle that `mixcr exportPreset` writes. 'undefined' when any level is missing.
_cloneAssemblerParameters := func(presetContent) {
	if !is_map(presetContent) {
		return undefined
	}
	assemble := presetContent.assemble
	if !is_map(assemble) {
		return undefined
	}
	params := assemble.cloneAssemblerParameters
	if !is_map(params) {
		return undefined
	}
	return params
}

// assemblingFeatures resolves the gene features the run assembles by, as MiXCR feature strings
// (brace forms included).
//
// `assembleClonesBy` is the user override from "Advanced Settings" and is undefined on every
// run that does not set it, including kit presets that carry a feature of their own. Those
// presets set it through the SetClonotypeAssemblingFeatures mixin, which lands in the resolved
// bundle as `assemble.cloneAssemblerParameters.assemblingFeatures` — takara VDJRegion, biomed2
// `{CDR1Begin:CDR3End}`, and the same for qiaseq, idt, neb, illumina, abhelix and vasa.
//
// The field is null in `assemble-base`, which every generic amplicon preset inherits: those
// runs pick the feature from a flag at runtime and assemble by CDR3 when no flag is given.
_DEFAULT_ASSEMBLING_FEATURE := "CDR3"

assemblingFeatures := func(presetContent, assembleClonesBy) {
	if !is_undefined(assembleClonesBy) {
		return [assembleClonesBy]
	}

	params := _cloneAssemblerParameters(presetContent)
	if !is_undefined(params) && is_array(params.assemblingFeatures) && len(params.assemblingFeatures) > 0 {
		return params.assemblingFeatures
	}

	return [_DEFAULT_ASSEMBLING_FEATURE]
}

// assembleEstimate reads the estimate of `initialClonesCreated` the `align` step reports: the
// distinct clonal keys (assembling-feature tuple plus the split genes' best hits) among reads
// with no base below `badQualityThreshold`, which is the number of accumulators `assemble`
// holds at its peak.
//
// The field is `estimatedClonotypes: { assemblingFeatures, splitBy, qualityThreshold,
// initialClones, cdr3 }`. `align` computes it under the same assembler parameters the run
// assembles with, so no cross-check against the preset is needed here.
//
// Returns 'undefined' when the field is missing or unreadable: a MiXCR pin older than the sketch
// writes no field at all. That takes the caller's fallback rule.
assembleEstimate := func(alignReport) {
	if !is_map(alignReport) {
		return undefined
	}
	estimate := alignReport.estimatedClonotypes
	if !is_map(estimate) {
		return undefined
	}
	count := int(estimate.initialClones)
	if is_undefined(count) || count < 0 {
		return undefined
	}
	return count
}

// assembleXmxGiB sizes the `assemble` heap from that estimate. Fitted on floors against the
// final clone count; on the synthetic ladder the initial count is 1.03x the final, so the
// estimate grants about 3 % more. A refit on initial clones from real data is pending. The rule is piecewise, with one
// slope per object-pointer width:
//
//     Xmx_GiB = 11.0 x est_M + 2   when that value is at most 29.5
//               15.7 x est_M + 2   otherwise
//
// The same clone set occupies 0.67 to 0.70 of the memory under compressed object pointers that it
// occupies at full pointer width. HotSpot turns compressed object pointers off at a maximum heap
// of about 32 GiB; 29.5 keeps the compressed branch clear of that boundary.
//
// Slopes and intercept are fitted on bisected `assemble` floors. Against those floors the rule
// grants 6 for 5, 13 for 11, 27 for 24, 74 for 71 and 81 for 77 — never under, worst over-grant
// 1.20x.
_ASSEMBLE_GIB_PER_M_COMPRESSED := 11.0
_ASSEMBLE_GIB_PER_M := 15.7
_COMPRESSED_OOPS_MAX_XMX_GIB := 29.5
_ASSEMBLE_INTERCEPT_GIB := 2.0
_ASSEMBLE_FLOOR_GIB := 4
_ASSEMBLE_CAP_GIB := 256

assembleXmxGiB := func(estimatedClonotypes) {
	millions := float(estimatedClonotypes) / 1000000.0
	compressed := _ASSEMBLE_GIB_PER_M_COMPRESSED * millions + _ASSEMBLE_INTERCEPT_GIB
	if compressed <= _COMPRESSED_OOPS_MAX_XMX_GIB {
		return compressed
	}
	return _ASSEMBLE_GIB_PER_M * millions + _ASSEMBLE_INTERCEPT_GIB
}

// assembleRamGiB converts that heap into the grant that produces it.
//
//     ram = clamp(grantGiBForXmx(assembleXmxGiB(est)), 4 GiB, 256 GiB)
//
// The 4 GiB floor never binds: the additive arm of the entrypoint inverse holds the smallest run
// at 6 GiB. The cap is 256 GiB.
assembleRamGiB := func(estimatedClonotypes) {
	grant := grantGiBForXmx(assembleXmxGiB(estimatedClonotypes))
	if grant < _ASSEMBLE_FLOOR_GIB {
		return _ASSEMBLE_FLOOR_GIB
	}
	if grant > _ASSEMBLE_CAP_GIB {
		return _ASSEMBLE_CAP_GIB
	}
	return grant
}

// assembleFallbackRam sizes `assemble` when the align report carries no estimate, which is
// every run on a MiXCR pin older than the sketch and every run that splits clones by gene.
//
//     ram = clamp(3 x size("vdjca"), baseMemGiB, 256 GiB)
//
// The volume term reads the `.vdjca` rather than the FASTQs because exec.formula sizes only
// files the command stages, and `assemble` stages the aligned file alone. A `.vdjca` is 1.3 to
// 2.0 times the compressed FASTQ pair, so 3 x size("vdjca") is never below the 4 x size("reads")
// that `analyze` requests. Floor and cap are the ones `analyze` carries today.
//
// The caller must tag its `.vdjca` input `{ tag: "vdjca" }`.
assembleFallbackRam := func(baseGiB) {
	return f.size("vdjca").times(3).
		between(f.gib(baseGiB), f.gib(256)).
		staticFallback(f.gib(baseGiB))
}

// exportRam builds the exec.formula node for an `exportClones` step.
//
//     ram = clamp(interceptGiB + perByte x size("clns"), floorGiB, 256 GiB)
//
// exportClones reads the whole CloneSet into heap and applies --chains after that read, so
// the request tracks the .clns and not the exported field set.
//
// Every caller must tag its .clns input `{ tag: "clns" }`. size("clns") reads file metadata
// through getBlobSize.
//
// Measured fit across five samples, .clns 0.13 to 1.31 GiB:
//     export peak = 6.4 + 25.0 x clns_GiB     (R2 0.970)
//
// perByte is the peak divided by the caller's heap fraction, times any workload expansion:
//   30  bulk export on `memory-from-limits` (-Xmx = 0.85 x grant)
//   32  the same export under the divideClonesByTags expansion of a single-cell run
//
// floorGiB must hold the whole active range above a 23 GiB grant. Below that grant
// `memory-from-limits` binds on `grant - 3500 MiB`, which is under the 0.85 that perByte is
// fitted to. 24 GiB holds; 16 GiB leaves a .clns of 0.25 to 0.38 GiB under its measured peak.
//
// interceptGiB is a fitted term for JVM and reference-library overhead, not a second floor.
// The formula adds it and does not clamp it.
//
// perProcessMemGB is the "Advanced Settings" override. It RAISES the floor and does not
// replace the rule: a value below floorGiB has no effect, and the data term still applies
// above one above it. aggregate-by-clonotype-key treats the same override the same way.
exportRamCapGiB := 256
exportRamInterceptGiB := 8

exportRam := func(perProcessMemGB, floorGiB, perByte) {
	floor := floorGiB
	if !is_undefined(perProcessMemGB) {
		floor = int(math.max(perProcessMemGB, floorGiB))
	}
	// An override above the cap raises the cap. between() asserts lo <= hi, so leaving the
	// cap at 256 GiB would panic on any override above it rather than clamp.
	cap := int(math.max(floor, exportRamCapGiB))
	return f.gib(exportRamInterceptGiB).
		plus(f.size("clns").times(perByte)).
		between(f.gib(floor), f.gib(cap)).
		staticFallback(f.gib(floor))
}

export {
	baseMemGiB: baseMemGiB,
	memFormula: memFormula,
	grantGiBForXmx: grantGiBForXmx,
	assemblingFeatures: assemblingFeatures,
	assembleEstimate: assembleEstimate,
	assembleXmxGiB: assembleXmxGiB,
	assembleRamGiB: assembleRamGiB,
	assembleFallbackRam: assembleFallbackRam,
	exportRam: exportRam
}
