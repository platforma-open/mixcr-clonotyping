// Identity of this template for the platform's deduplication. Changing this value means
// "re-run every sample on the next block update" — see the longer note in :mixcr-analyze.
// Rotated whenever the template graph below it changes; reusing the old value would serve
// cache hits from a different computation.
//tengo:hash_override 8538713A-E5EB-4181-8989-C733B2E7302E

// Runs MiXCR on one measured sample.
//
// Two pipelines, matched whole, run each step as its own exec, so each step carries its own
// memory grant instead of sharing the worst step's:
//
//   - `align, assemble, exportClones`: `assemble` is sized from the clonotype estimate the
//     align report carries, which a template can only read after the align command has
//     finished, so `assemble` and `qc` live in :assemble-mixcr.
//   - `align, refineTagsAndSort, assemble, exportClones`: `refineTagsAndSort`, `assemble` and
//     `qc` live in :refine-assemble-mixcr, each sized from the `.vdjca` it stages. A preset whose
//     tag pattern captures a cell barcode takes the cell-barcoded assemble rule.
//
// In both, a preset on the long-read aligner takes the long-read assemble rule.
//
// The in-chain `exportClones` is dropped rather than reproduced: the block saves no clones.tsv
// from it and re-exports from the .clns with its own argv in :mixcr-export.
//
// Every other preset keeps the single `analyze` command.

self := import("@platforma-sdk/workflow-tengo:tpl")
smart := import("@platforma-sdk/workflow-tengo:smart")
render := import("@platforma-sdk/workflow-tengo:render")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
ll := import("@platforma-sdk/workflow-tengo:ll")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
times := import("times")
text := import("text")
maps := import("@platforma-sdk/workflow-tengo:maps")
memf := import(":mem-formula")
readStats := import(":read-stats")

json := import("json")

self.defineOutputs("qc", "reports", "log", "clns")

mixcrSw := assets.importSoftware("@platforma-open/milaboratories.software-mixcr:memory-from-limits")
assembleMixcrTpl := assets.importTemplate(":assemble-mixcr")
refineAssembleMixcrTpl := assets.importTemplate(":refine-assemble-mixcr")

progressPrefix := "[==PROGRESS==]"

CACHE_PERIOD := 48 * times.hour

// The pipelines that run as separate execs, matched whole. A pipeline carrying any other step
// falls through to `analyze`.
PIPELINE_BULK := ["align", "assemble", "exportClones"]
PIPELINE_UMI := ["align", "refineTagsAndSort", "assemble", "exportClones"]

// Flat `align` grant of a split run. `align` streams its input, so the grant does not scale
// with the sample.
ALIGN_RAM_GIB := 24

_sameSteps := func(pipeline, steps) {
	if len(pipeline) != len(steps) {
		return false
	}
	for i, step in steps {
		if pipeline[i] != step {
			return false
		}
	}
	return true
}

self.body(func(inputs) {
	inputData := inputs[pConstants.VALUE_FIELD_NAME]
	aggregationAxesNames := inputs[pConstants.AGGREGATION_AXES_NAMES_FIELD_NAME]

	// Disposable disk space for MiXCR's temporary files. TMPDIR points at a volume of this
	// size, which is why --use-local-temp is gone: it wrote into the working directory on the
	// shared workspace storage, where the I/O is slower and billed. The SDK guarantees TMPDIR
	// on every backend now - it stages a wrapper script where the backend cannot - so there is
	// no version of Platforma left that needs the old flag.
	// 'undefined' when :mixcr-analyze found no read end to measure.
	//
	// One number covers every step of a split run. :read-stats folds the sequence-volume term
	// and the read-length term into a single max and exposes no way to separate them, so the
	// step that needs the smaller of the two over-requests disk.
	mixcrScratchSpace := readStats.scratchFreeSpaceFor(inputs.readStats)

	preset := inputs.preset
	library := inputs.library

	params := inputs.params
	species := params.species
	limitInput := params.limitInput
	leftAlignmentMode := params.leftAlignmentMode
	rightAlignmentMode := params.rightAlignmentMode
	materialType := params.materialType
	tagPattern := params.tagPattern
	assembleClonesBy := params.assembleClonesBy
	perProcessMemGB := inputs.perProcessMemGB
	perProcessCPUs := inputs.perProcessCPUs
	fileExtension := params.fileExtension
	reports := params.reports
	isLibraryFileGzipped := params.isLibraryFileGzipped

	presetContent := inputs.presetContent.getDataAsJson()

	if !is_map(presetContent) || !is_array(presetContent.pipeline) {
		ll.panic("malformed presetContent %v", presetContent)
	}

	inputDataMeta := inputData.getDataAsJson()

	hasAssembleContigs := false
	hasAssembleCells := false
	hasMiToolSteps := false
	for stage in presetContent.pipeline {
		if stage == "assembleContigs" {
			hasAssembleContigs = true
		} else if stage == "assembleCells" {
			hasAssembleCells = true
		} else if text.has_prefix(stage, "mitool-") {
			hasMiToolSteps = true
		}
	}

	splitBulk := _sameSteps(presetContent.pipeline, PIPELINE_BULK)
	splitUmi := _sameSteps(presetContent.pipeline, PIPELINE_UMI)
	longRead := memf.hasLongReadAligner(presetContent)

	clnsFileName := "result.clns"
	if hasAssembleContigs {
		clnsFileName = "result.contigs.clns"
	}
	if hasAssembleCells {
		clnsFileName = "result.assembledCells.clns"
	}

	// CPUs number per process
	perProcessCPUsResolved := is_undefined(perProcessCPUs) ? 16 : perProcessCPUs

	baseMemGiB := memf.baseMemGiB(hasMiToolSteps, hasAssembleContigs, hasAssembleCells)

	newMixcrBuilder := func() {
		return exec.builder().
			printErrStreamToStdout().
			saveStdoutStream().
			env("MI_USE_SYSTEM_CA", "true").
			env("MI_PROGRESS_PREFIX", progressPrefix).
			software(mixcrSw).
			secret("MI_LICENSE", "MI_LICENSE").
			env("MI_LICENSE_DEBUG", "MI_LICENSE_DEBUG")
	}

	// Memory limit per process. `ram` is the step's own grant. `analyze` passes
	//     mem = clamp(4 * size("reads"), baseMemGiB, 256 GiB)
	// size("reads") sums the stored (compressed) blob size of the sample's R1+R2 FASTQ
	// via getBlobSize — a metadata read, no pre-exec — so it tracks total input volume
	// (read count and read length) without decompressing.
	// baseMemGiB is a TOTAL-memory floor for the analysis, so it acts as the lower bound
	// rather than a base to add data on top of. It is 64 GiB, rising to 110 or 192 for
	// contig/cell and single-cell+MiTool pipelines, which need that headroom whatever the
	// input size. The linear term scales with input volume, and the 256 GiB cap bounds
	// the largest runs.
	// An "Advanced Settings" memory override takes precedence. On backends that cannot
	// evaluate resource formulas, the formula's static fallback is the baseline.
	applyResources := func(builder, ram) {
		onCPUResources := { cpu: perProcessCPUsResolved }
		if !is_undefined(perProcessMemGB) {
			// memory per process was set in "Advanced Settings" block directly
			onCPUResources.ram = string(perProcessMemGB) + "GiB"
		} else {
			onCPUResources.ram = ram
		}
		if !is_undefined(mixcrScratchSpace) {
			onCPUResources.scratchFreeSpace = mixcrScratchSpace
		}
		builder.resources({ onCPU: onCPUResources })
		return builder
	}

	// Preset selection and every mixin that shapes the resolved parameter bundle. `align`
	// packs that bundle into the .vdjca header, and the later steps read it from there, so
	// this whole group belongs to the first command of the run whichever shape it takes.
	//
	// `analyze` takes the preset as its first positional; `align` takes it as `--preset`.
	// Every mixin below is an option on both, because align declares the same mixin groups
	// (AlignMiXCRMixins, AssembleMiXCRMixins, GenericMiXCRMixins) that analyze does.
	applyPresetArgs := func(builder, presetAsOption) {
		if library {
			builder.arg("--species").arg(species)
			if isLibraryFileGzipped {
				builder.arg("--library").arg("library.json.gz").
				addFile("library.json.gz", library)
			} else {
				builder.arg("--library").arg("library.json").
				addFile("library.json", library)
			}
		} else if !is_undefined(species) {
			builder.arg("--species").arg(species)
		}

		if presetAsOption {
			builder.arg("--preset")
		}
		if smart.isResource(preset) /* file */ {
			builder.
				arg("local#input_preset").
				addFile("input_preset.yaml", preset)
		} else {
			ll.assert(!is_undefined(preset.name), "undefined preset name")
			builder.
				arg(preset.name)
		}

		// Optional preset-specific parameters (order matters if preset requires positional values)
		if !is_undefined(leftAlignmentMode) {
			builder.arg(leftAlignmentMode)
		}
		if !is_undefined(rightAlignmentMode) {
			builder.arg(rightAlignmentMode)
		}
		if !is_undefined(materialType) {
			builder.arg(materialType)
		}
		if !is_undefined(tagPattern) {
			builder.arg("--tag-pattern").arg(tagPattern)
		}
		if !is_undefined(assembleClonesBy) {
			builder.arg("--assemble-clonotypes-by").arg(assembleClonesBy)
		}
		// Clone clustering tuning
		cloneClusteringMode := params.cloneClusteringMode
		if is_undefined(cloneClusteringMode) {
			cloneClusteringMode = "default"
		}
		if cloneClusteringMode == "relaxed" {
			builder.
				arg("-Massemble.cloneAssemblerParameters.minimalQuality=20").
				arg("-Massemble.cloneAssemblerParameters.badQualityThreshold=10").
				arg("-Massemble.cloneAssemblerParameters.cloneClusteringParameters.searchParameters=oneMismatchOrIndel").
				arg("-Massemble.cloneAssemblerParameters.cloneClusteringParameters.searchDepth=1")
		} else if cloneClusteringMode == "off" {
			builder.arg("-Massemble.cloneAssemblerParameters.cloneClusteringParameters=null")
		}
		return builder
	}

	// Stages the sample's read files and adds the positional pattern that names them.
	applyInputFiles := func(builder) {
		inputMap := inputData.inputs()
		if inputDataMeta.keyLength == 0 {
			ll.assert(aggregationAxesNames == [], "unexpected aggregation axes names")
			// Assuming only one key "[]" exists here, no need for sorted iteration
			inputFile := inputMap["[]"]
			ll.assert(!is_undefined(inputFile), "unexpected agg group structure")
			inputFileName := "input." + fileExtension
			builder.addFile(inputFileName, inputFile, { tag: "reads" })
			builder.arg(inputFileName)
		} else if inputDataMeta.keyLength == 1 {
			ll.assert(aggregationAxesNames == ["pl7.app/sequencing/readIndex"], "unexpected aggregation axes names")
			for sKey in maps.getKeys(inputMap) {
				inputFile := inputMap[sKey]
				key := json.decode(sKey)
				if len(key) != 1 {
					ll.panic("malformed key: %v", sKey)
				}
				r := key[0]
				if (r[0] != 'R' && r[0] != "I") || (r[1] != '1' && r[1] != '2') || len(r) != 2 {
					ll.panic("malformed read index: %v", r)
				}
				builder.addFile("input_" + r + "." + fileExtension, inputFile, { tag: "reads" })
			}
			builder.arg("input_{{R}}." + fileExtension)
		} else if inputDataMeta.keyLength == 2 {
			ll.assert(aggregationAxesNames == ["pl7.app/sequencing/lane", "pl7.app/sequencing/readIndex"], "unexpected aggregation axes names")
			for sKey in maps.getKeys(inputMap) {
				inputFile := inputMap[sKey]
				key := json.decode(sKey)
				if len(key) != 2 {
					ll.panic("malformed key: %v", sKey)
				}
				lane := key[0]
				r := key[1]
				if (r[0] != 'R' && r[0] != "I") || (r[1] != '1' && r[1] != '2') || len(r) != 2 {
					ll.panic("malformed read index: %v", r)
				}
				if is_undefined(int(lane)) {
					ll.panic("malformed lane: %v", lane)
				}
				builder.addFile("input_L" + lane + "_" + r + "." + fileExtension, inputFile, { tag: "reads" })
			}
			builder.arg("input_L{{n}}_{{R}}." + fileExtension)
		} else {
			ll.panic("too many axes / not supported")
		}
		return builder
	}

	// One stdout stream per command, keyed by the step that wrote it. `analyze` runs every
	// step in one JVM and contributes a single entry.
	logs := pcolumn.resourceMapBuilder( /* keyLength */ 1 )

	if !splitBulk && !splitUmi {
		mixcrCmdBuilder := newMixcrBuilder().arg("analyze")
		applyResources(mixcrCmdBuilder, memf.memFormula(baseMemGiB))

		if !is_undefined(limitInput) {
			mixcrCmdBuilder.arg("--limit-input").arg(string(limitInput))
		}

		applyPresetArgs(mixcrCmdBuilder, false)
		applyInputFiles(mixcrCmdBuilder)

		mixcrCmdBuilder.arg("result")
		mixcrCmdBuilder.arg("--force-overwrite")

		mixcrCmdBuilder.saveFile("result.qc.json")
		mixcrCmdBuilder.saveFile(clnsFileName)

		for report in reports {
			mixcrCmdBuilder.saveFile(report.fileJson)
			mixcrCmdBuilder.saveFile(report.fileTxt)
		}

		mixcrCmd := mixcrCmdBuilder.cache(CACHE_PERIOD).run()

		reportsMap := pcolumn.resourceMapBuilder( /* keyLength */ 2 )
		for report in reports {
			reportsMap.add([report.id, "json"], mixcrCmd.getFile(report.fileJson))
			reportsMap.add([report.id, "txt"], mixcrCmd.getFile(report.fileTxt))
		}

		logs.add(["analyze"], mixcrCmd.getStdoutStream())

		return {
			qc: mixcrCmd.getFile("result.qc.json"),
			log: logs.build(),
			reports: reportsMap.build(),
			clns: mixcrCmd.getFile(clnsFileName)
		}
	}

	alignReportJson := "result.align.report.json"
	alignReportTxt := "result.align.report.txt"
	alignedFile := "result.vdjca"

	alignBuilder := newMixcrBuilder().arg("align").arg("-f")
	applyResources(alignBuilder, string(ALIGN_RAM_GIB) + "GiB")

	// `--threads` exists on align alone of the three steps. Reading the granted count back
	// from the placeholder keeps the flag and the request from diverging.
	alignBuilder.arg("--threads").argExpr("{system.cpu}")

	if !is_undefined(limitInput) {
		alignBuilder.arg("--limit-input").arg(string(limitInput))
	}

	applyPresetArgs(alignBuilder, true)

	alignBuilder.
		arg("--report").arg(alignReportTxt).
		arg("--json-report").arg(alignReportJson)

	applyInputFiles(alignBuilder)

	// The report is saved twice: as a file, which is what the reports p-column carries, and
	// as content, which is the only form :assemble-mixcr can decode to size itself.
	alignCmd := alignBuilder.
		arg(alignedFile).
		saveFile(alignedFile).
		saveFile(alignReportJson).
		saveFileContent(alignReportJson).
		saveFile(alignReportTxt).
		cache(CACHE_PERIOD).
		run()

	logs.add(["align"], alignCmd.getStdoutStream())

	// Kept out of the deduplication key for the same reason :mixcr-analyze keeps them out of
	// this template's: a run is recovered across a change of the CPU or memory override. The
	// scratch request rides along; it never changes what the step produces.
	childMetaInputs := {
		perProcessMemGB: perProcessMemGB,
		perProcessCPUs: perProcessCPUs,
		scratchFreeSpace: mixcrScratchSpace
	}

	if splitUmi {
		refineAssembleRun := render.create(
			refineAssembleMixcrTpl,
			{
				vdjca: alignCmd.getFile(alignedFile),
				alignReportJson: alignCmd.getFile(alignReportJson),
				alignReportTxt: alignCmd.getFile(alignReportTxt),

				assembleRule: longRead ? "longRead" : (memf.hasCellTag(presetContent) ? "cell" : "umi"),
				clnsFileName: clnsFileName,
				reports: reports
			},
			{ metaInputs: childMetaInputs }
		)

		logs.add(["refineTagsAndSort"], refineAssembleRun.output("refineLog", CACHE_PERIOD))
		logs.add(["assemble"], refineAssembleRun.output("log", CACHE_PERIOD))
		logs.add(["qc"], refineAssembleRun.output("qcLog", CACHE_PERIOD))

		return {
			qc: refineAssembleRun.output("qc", CACHE_PERIOD),
			log: logs.build(),
			reports: refineAssembleRun.output("reports", CACHE_PERIOD),
			clns: refineAssembleRun.output("clns", CACHE_PERIOD)
		}
	}

	assembleRun := render.create(
		assembleMixcrTpl,
		{
			vdjca: alignCmd.getFile(alignedFile),
			alignReport: alignCmd.getFileContent(alignReportJson),
			alignReportJson: alignCmd.getFile(alignReportJson),
			alignReportTxt: alignCmd.getFile(alignReportTxt),

			clnsFileName: clnsFileName,
			reports: reports,
			assemblingFeatures: memf.assemblingFeatures(presetContent, assembleClonesBy),
			longRead: longRead
		},
		{ metaInputs: childMetaInputs }
	)

	logs.add(["assemble"], assembleRun.output("log", CACHE_PERIOD))
	logs.add(["qc"], assembleRun.output("qcLog", CACHE_PERIOD))

	return {
		qc: assembleRun.output("qc", CACHE_PERIOD),
		log: logs.build(),
		reports: assembleRun.output("reports", CACHE_PERIOD),
		clns: assembleRun.output("clns", CACHE_PERIOD)
	}
})
