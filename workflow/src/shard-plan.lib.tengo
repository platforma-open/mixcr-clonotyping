// Shard plan for the cohort clonotype aggregation (:aggregate-by-clonotype-key-shards).
//
// The aggregation groups all samples' clonotype rows by clonotypeKey and keeps, per column,
// the value from the most abundant sample (maxBy). ptabler lowers maxBy to
// top_k_by(k=1).first(), which polars runs as an in-memory group-by: one run holds every
// group it produces at once, and its peak follows the number of input rows, not the grant.
//
// Rows are split into shards by the first letter of the clonotypeKey after digits are
// removed, upper-cased. Each shard is one ptabler run over all input files with a filter on
// that letter set, so a run holds only its own groups. A key always maps to one shard, so
// every group is complete inside a shard and the shard outputs are disjoint.
//
// The clonotype label (C-XXXXX or C-XXXXX-N) ranks keys inside a five-letter prefix built the
// same way. The shard letter is the first letter of that prefix, so a prefix never spans two
// shards and the label is computed inside the shard.
//
// clonotypeKey is a 120-bit sha256 in the base64 alphanumeric alphabet (A-Z, a-z, 0-9), so
// after digit removal and upper-casing the first character is one of 26 letters, each with
// equal probability. Letters are dealt to shards round-robin. A key with no letters at all
// (all digits) has an empty bucket and belongs to shard 0.
//
// Memory per shard:
//
//     need(rows) = INTERCEPT_GIB + rows x RAM_PER_ROW_BYTES
//
// RAM_PER_ROW_BYTES is the concat + maxBy law from MILAB-6874 -- 4.94 GiB of RAM per GiB of
// TSV at eight polars threads -- applied to about 0.5 KiB per exported clonotype row, rounded
// up to 4 KiB. The shard count is the smallest that brings the largest shard under the target
// grant; if 26 shards are not enough the largest shard's need is requested as-is.
//
// The row count comes from the SDK line-counter run on every input TSV by
// :aggregate-by-clonotype-key. Each file has one header line.

math := import("math")
text := import("text")

LETTERS := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
MAX_SHARDS := len(LETTERS)

INTERCEPT_GIB := 2
RAM_PER_ROW_BYTES := 4 * 1024
DEFAULT_SHARD_GIB := 64
SHARD_CPU := 8

GIB := 1024 * 1024 * 1024

// ceilDiv returns ceil(a / b) for non-negative integers.
ceilDiv := func(a, b) {
	return (a + b - 1) / b
}

// needGiB returns the whole GiB one shard of `rows` rows requires.
needGiB := func(rows) {
	return INTERCEPT_GIB + ceilDiv(rows * RAM_PER_ROW_BYTES, GIB)
}

// shardLetters deals the 26 letters round-robin into `count` shards.
// Returns an array of strings, one per shard, each string the letters of that shard.
shardLetters := func(count) {
	shards := []
	for i := 0; i < count; i++ {
		shards = append(shards, "")
	}
	for i := 0; i < MAX_SHARDS; i++ {
		shards[i % count] += LETTERS[i:i+1]
	}
	return shards
}

// plan chooses the shard count and the per-shard grant.
//
// @param totalRows: int | undefined - clonotype rows over all input files; undefined when the
//                   count is unavailable, which yields a single shard at the target grant.
// @param targetGiB: int - grant each shard should stay under (the memory override, or
//                   DEFAULT_SHARD_GIB)
// @return { shards: [string], memGiB: int, cpu: int }
plan := func(totalRows, targetGiB) {
	if is_undefined(totalRows) || totalRows <= 0 {
		return { shards: [LETTERS], memGiB: targetGiB, cpu: SHARD_CPU }
	}

	count := 1
	largest := totalRows
	for count < MAX_SHARDS {
		lettersMax := ceilDiv(MAX_SHARDS, count)
		largest = ceilDiv(totalRows * lettersMax, MAX_SHARDS)
		if needGiB(largest) <= targetGiB {
			break
		}
		count++
	}
	if count == MAX_SHARDS {
		largest = ceilDiv(totalRows, MAX_SHARDS)
	}

	return {
		shards: shardLetters(count),
		memGiB: int(math.max(targetGiB, needGiB(largest))),
		cpu:    SHARD_CPU
	}
}

// bucketExpr returns the pt expression for a row's shard letter.
bucketExpr := func(pt, keyCol) {
	return pt.col(keyCol).
		fillNull("").
		strReplace("\\d", "", { replaceAll: true }).
		strSlice(0, 1).
		strToUpper()
}

// shardPredicate returns the pt filter expression selecting rows whose shard letter is one of
// `letters`. With catchAll the empty bucket is included.
shardPredicate := func(pt, keyCol, letters, catchAll) {
	bucket := bucketExpr(pt, keyCol)
	pred := undefined
	for i := 0; i < len(letters); i++ {
		term := bucket.eq(pt.lit(letters[i:i+1]))
		pred = is_undefined(pred) ? term : pred.or(term)
	}
	if catchAll {
		pred = pred.or(bucket.eq(pt.lit("")))
	}
	return pred
}

// parseLineCount reads a line-counter output (a base-10 integer, optional whitespace).
// Returns undefined when the text is not an integer.
parseLineCount := func(data) {
	return int(text.trim(string(data), "\n \r\t"))
}

// totalRowsFromLineCounts sums clonotype rows over per-file line counts, one header line per
// file. Returns undefined when any count is missing or unparsable.
totalRowsFromLineCounts := func(lineCounts) {
	total := 0
	for _, data in lineCounts {
		n := parseLineCount(data)
		if is_undefined(n) {
			return undefined
		}
		if n > 0 {
			total += n - 1
		}
	}
	return total
}

export {
	LETTERS: LETTERS,
	MAX_SHARDS: MAX_SHARDS,
	INTERCEPT_GIB: INTERCEPT_GIB,
	RAM_PER_ROW_BYTES: RAM_PER_ROW_BYTES,
	DEFAULT_SHARD_GIB: DEFAULT_SHARD_GIB,
	SHARD_CPU: SHARD_CPU,

	needGiB: needGiB,
	shardLetters: shardLetters,
	plan: plan,
	bucketExpr: bucketExpr,
	shardPredicate: shardPredicate,
	parseLineCount: parseLineCount,
	totalRowsFromLineCounts: totalRowsFromLineCounts
}
