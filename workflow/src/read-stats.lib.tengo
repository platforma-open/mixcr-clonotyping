// Single source of truth for the `mixcr analyze` scratch space request.
//
//     GiB = 11 x millionsOfReads x (averageReadLength / 1000) ^ 2
//
// Neither number is in the p-column metadata, so the reads are measured with
// 'seqkit stats' and the result is read back as JSON through 'csvtk'. Only one read end is
// measured: read ends are symmetrical, so one of them describes the whole sample.
//
// Measuring is a command, so its result is a resource. A template cannot read the result of
// a command it started itself, which is why measure() and scratchFreeSpaceFor() are called
// from two different templates: :mixcr-analyze starts the measurement, :mixcr-run reads it.
//
// The request is an optimisation and never a precondition. Every unusable case — no read end
// to measure, an unparsable number — returns 'undefined', the field is left out, and the
// command runs with whatever temporary storage its runner provides by default.

exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
smart := import("@platforma-sdk/workflow-tengo:smart")
maps := import("@platforma-sdk/workflow-tengo:maps")

times := import("times")
json := import("json")

seqkitSw := assets.importSoftware("@platforma-open/milaboratories.software-binary-collection:seqkit")
csvtkSw := assets.importSoftware("@platforma-open/milaboratories.software-binary-collection:csvtk")

// How long a measurement may be reused. Matches the MiXCR run cache, so a repeated analysis
// of the same sample reads the file no more often than it runs MiXCR.
CACHE_PERIOD := 48 * times.hour

// CPU cores asked for the read pass. seqkit parallelises across files and this pass reads a
// single one, so more cores buy little; the command reads the granted count back from
// '{system.cpu}' rather than repeating this number, so the two can never diverge.
STATS_CPU := 1

// readEndToMeasure picks the single read end that describes the sample: the first R1 in key
// order, or the only file when the reads are not split by read index. Returns 'undefined'
// when the sample holds no R1.
readEndToMeasure := func(inputMap, keyLength) {
	if keyLength == 0 {
		return inputMap["[]"]
	}

	chosenKey := undefined
	for sKey in maps.getKeys(inputMap) {
		key := json.decode(sKey)
		if len(key) != keyLength {
			continue
		}
		if key[keyLength - 1] != "R1" {
			continue
		}
		if is_undefined(chosenKey) || sKey < chosenKey {
			chosenKey = sKey
		}
	}

	if is_undefined(chosenKey) {
		return undefined
	}
	return inputMap[chosenKey]
}

// measure runs the read statistics of one read end of the sample.
//
// @param inputData: resource - the aggregated p-column data holding the sample's read files
// @param fileExtension: string - extension of those files, e.g. "fastq.gz"
// @return resource - content of a one-element JSON array, to be passed to
//                    scratchFreeSpaceFor() in another template; 'undefined' when the sample
//                    holds no read end to measure.
measure := func(inputData, fileExtension) {
	readsFile := readEndToMeasure(inputData.inputs(), inputData.getDataAsJson().keyLength)
	if is_undefined(readsFile) {
		return undefined
	}

	readsFileName := "reads." + fileExtension

	// seqkit reads the whole file, so it gets the same queue as other data passes.
	// '--tabular' makes the output a single header line plus a single data line.
	statsCmd := exec.builder().
		inMediumQueue().
		cpu(STATS_CPU).
		mem("1GiB").
		software(seqkitSw).
		addFile(readsFileName, readsFile).
		arg("stats").
		arg("--threads").
		argExpr("{system.cpu}").
		arg("--tabular").
		arg(readsFileName).
		saveStdoutFile().
		cache(CACHE_PERIOD).
		run()

	// csvtk turns those two lines into a one-element JSON array, so the fields can be read
	// by name instead of by column position. '--tabs' sets the tab delimiter; passing it as
	// '--delimiter' with an escaped tab does not survive the trip to the command, which sees
	// a two-character string and rejects it.
	statsFileName := "stats.tsv"
	statsJsonCmd := exec.builder().
		inLightQueue().
		cpu(1).
		mem("256MiB").
		software(csvtkSw).
		addFile(statsFileName, statsCmd.getStdoutFile()).
		arg("--tabs").
		arg("csv2json").
		arg(statsFileName).
		saveStdoutContent().
		cache(CACHE_PERIOD).
		run()

	return statsJsonCmd.getStdoutContent()
}

// scratchFreeSpaceFor turns a measure() result into a size string for
// `.resources({onCPU:{scratchFreeSpace}})`. Accepts the resource as it arrives in a template
// input, or the already decoded array. Returns 'undefined' when there is nothing to size on.
scratchFreeSpaceFor := func(readStats) {
	if smart.isResource(readStats) {
		readStats = readStats.getDataAsJson()
	}
	if !is_array(readStats) || len(readStats) == 0 {
		return undefined
	}

	stats := readStats[0]
	numberOfReads := int(stats.num_seqs)
	averageReadLength := float(stats.avg_len)
	if is_undefined(numberOfReads) || is_undefined(averageReadLength) {
		return undefined
	}
	if numberOfReads <= 0 || averageReadLength <= 0.0 {
		return undefined
	}

	millionsOfReads := float(numberOfReads) / 1000000.0
	kilobases := averageReadLength / 1000.0
	gib := 11.0 * millionsOfReads * kilobases * kilobases

	// Rounded up: a sample small enough to land below one whole GiB still needs scratch
	// space, and a request of zero reads as no request at all.
	wholeGiB := int(gib)
	if float(wholeGiB) < gib {
		wholeGiB += 1
	}

	return string(wholeGiB) + "GiB"
}

export {
	CACHE_PERIOD: CACHE_PERIOD,
	measure: measure,
	scratchFreeSpaceFor: scratchFreeSpaceFor
}
