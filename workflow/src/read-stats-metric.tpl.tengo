// The custom metric template behind :read-stats: reads the read files of one sample and writes
// the metrics its scratch formula uses, as one JSON object:
//
//     {"reads": 72604410, "basesR1": 10963265910, "basesR2": 10963265910, "longestRead": 151}
//
//   reads       - reads of the sample, counted on R1 alone: it counts pairs, so adding R2
//                 would double it
//   basesR1     - bases of every R1 file, summed; summing rather than averaging is exact and
//                 needs no weighting when a sample spans lanes
//   basesR2     - the same for R2
//   longestRead - the longest read of either end
//
// 'seqkit stats' measures the files, 'jq' folds its table into the object. The platform runs
// this template once per sample, before the first step it sizes (exec.formula.customMetric).
//
// inputs.files: { <file name>: <file> } - the read files, by the names :run-mixcr stages them
// under: "input.<ext>", "input_R1.<ext>", "input_L1_R2.<ext>"
// outputs.output: the JSON object

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
maps := import("@platforma-sdk/workflow-tengo:maps")
slices := import("@platforma-sdk/workflow-tengo:slices")

times := import("times")

self.defineOutputs(["output"])

seqkitSw := assets.importSoftware("@platforma-open/milaboratories.software-binary-collection:seqkit")
jqSw := assets.importSoftware("@platforma-open/milaboratories.software-binary-collection:jq")

// How long a measurement may be reused. Matches the MiXCR run cache, so a repeated analysis
// of the same sample reads the files no more often than it runs MiXCR.
CACHE_PERIOD := 48 * times.hour

// Folds the table of 'seqkit stats --tabular' (a header line plus one line per file) into the
// JSON object. Fields are read by header name, not by column position. A file is R2 when its
// name says so ("input_R2.fastq.gz", "input_L1_R2.fastq.gz"); every other file given is R1,
// which also covers the single "input.fastq.gz" of a sample with no read index. An empty table
// gives zeros.
FOLD_PROGRAM := `split("\n") | map(select(length > 0) | split("\t")) | .[0] as $h | .[1:]
| map(. as $r | reduce range(0; $h | length) as $i ({}; .[$h[$i]] = $r[$i]))
| map(.r2 = (.file | test("_R2[._]")))
| {
    reads: (map(select(.r2 | not) | .num_seqs | tonumber) | add // 0),
    basesR1: (map(select(.r2 | not) | .sum_len | tonumber) | add // 0),
    basesR2: (map(select(.r2) | .sum_len | tonumber) | add // 0),
    longestRead: (map(.max_len | tonumber) | max // 0)
  }`

self.body(func(inputs) {
	names := slices.quickSort(maps.getKeys(inputs.files))

	// seqkit reads every file whole, so it gets the same queue as other data passes. One core
	// per file: seqkit parallelises across files, not within one, so a core beyond their number
	// would idle. The command reads the granted count back from '{system.cpu}' instead of
	// repeating the number, so the request and the flag can never diverge.
	stats := exec.builder().
		name("seqkit stats").
		inMediumQueue().
		cpu(len(names)).
		mem("1GiB").
		software(seqkitSw).
		arg("stats").
		arg("--threads").
		argExpr("{system.cpu}").
		arg("--tabular")
	for name in names {
		stats.addFile(name, inputs.files[name]).arg(name)
	}
	table := stats.saveStdoutFile().cache(CACHE_PERIOD).run().getStdoutFile()

	fold := exec.builder().
		name("read stats").
		inLightQueue().
		cpu(1).
		mem("256MiB").
		software(jqSw).
		addFile("stats.tsv", table).
		arg("--raw-input").
		arg("--slurp").
		arg("--compact-output").
		arg(FOLD_PROGRAM).
		arg("stats.tsv").
		saveStdoutContent().
		cache(CACHE_PERIOD).
		run()

	return { output: fold.getStdoutContent() }
})
