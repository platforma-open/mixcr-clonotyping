test := import("@platforma-sdk/workflow-tengo:test")
sp := import(":shard-plan")

// The customer cohort that motivated sharding: 113 samples, 130.4 M clonotype rows.
_ROWS_130M := 130400000

TestNeedGiBFollowsRows := func() {
	test.isEqual(sp.INTERCEPT_GIB, sp.needGiB(0))
	// 262144 rows x 4 KiB = exactly 1 GiB
	test.isEqual(sp.INTERCEPT_GIB + 1, sp.needGiB(262144))
	// one row over rounds up to the next GiB
	test.isEqual(sp.INTERCEPT_GIB + 2, sp.needGiB(262145))
}

TestShardLettersDealEveryLetterOnce := func() {
	one := sp.shardLetters(1)
	test.isEqual(1, len(one))
	test.isEqual(sp.LETTERS, one[0])

	seven := sp.shardLetters(7)
	test.isEqual(7, len(seven))
	joined := ""
	total := 0
	for s in seven {
		total += len(s)
		joined += s
	}
	test.isEqual(26, total)
	// round-robin: shard 0 takes A, H, O, V; shard 6 takes G, N, U
	test.isEqual("AHOV", seven[0])
	test.isEqual("GNU", seven[6])

	all := sp.shardLetters(26)
	test.isEqual(26, len(all))
	test.isEqual("A", all[0])
	test.isEqual("Z", all[25])
}

TestPlanSmallCohortIsOneShardAtTarget := func() {
	// 2.7 M rows (113 samples at 24k clonotypes) needs 2 + 11 GiB, under the 64 GiB target.
	p := sp.plan(2700000, sp.DEFAULT_SHARD_GIB)
	test.isEqual(1, len(p.shards))
	test.isEqual(sp.LETTERS, p.shards[0])
	test.isEqual(sp.DEFAULT_SHARD_GIB, p.memGiB)
	test.isEqual(sp.SHARD_CPU, p.cpu)
}

TestPlanUnknownRowsIsOneShardAtTarget := func() {
	p := sp.plan(undefined, 96)
	test.isEqual(1, len(p.shards))
	test.isEqual(96, p.memGiB)
}

TestPlanLargeCohortShards := func() {
	// 130.4 M rows x 4 KiB = 497.4 GiB + 2. Under a 64 GiB target the smallest shard count
	// whose largest shard fits is 9 (3 letters -> 15.05 M rows -> 2 + 58 = 60 GiB).
	p := sp.plan(_ROWS_130M, sp.DEFAULT_SHARD_GIB)
	test.isEqual(9, len(p.shards))
	test.isEqual(sp.DEFAULT_SHARD_GIB, p.memGiB)

	// A raised target needs fewer shards: 128 GiB -> 4 shards (7 letters -> 35.1 M rows ->
	// 2 + 134 GiB does not fit; 5 shards -> 6 letters -> 30.1 M rows -> 2 + 115 fits).
	p = sp.plan(_ROWS_130M, 128)
	test.isEqual(5, len(p.shards))
	test.isEqual(128, p.memGiB)
}

TestPlanBeyondTwentySixShardsRequestsTheNeed := func() {
	// 2 G rows: even 26 shards leave 76.9 M rows per shard = 2 + 294 GiB > 64.
	p := sp.plan(2000000000, sp.DEFAULT_SHARD_GIB)
	test.isEqual(26, len(p.shards))
	test.isEqual(sp.needGiB(76923077), p.memGiB)
	test.isTrue(p.memGiB > sp.DEFAULT_SHARD_GIB)
}

TestParseLineCount := func() {
	test.isEqual(42, sp.parseLineCount("42\n"))
	test.isEqual(0, sp.parseLineCount("0"))
	test.isTrue(is_undefined(sp.parseLineCount("not a number")))
}

TestTotalRowsSubtractsOneHeaderPerFile := func() {
	// three files: 101, 1 and 0 lines -> 100 + 0 + 0 rows
	test.isEqual(100, sp.totalRowsFromLineCounts({ a: "101\n", b: "1\n", c: "0\n" }))
	test.isTrue(is_undefined(sp.totalRowsFromLineCounts({ a: "10", b: "x" })))
	test.isEqual(0, sp.totalRowsFromLineCounts({}))
}
