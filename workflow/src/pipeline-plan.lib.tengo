// Turns a resolved preset into the list of per-step commands a split run executes, each with the
// name of its memory grant in :mem-formula, or 'undefined' when the pipeline carries a step the
// split does not know, and the run stays one `analyze` command.
//
// The plan reads only the resolved bundle `mixcr exportPreset` writes, so a preset from a file
// is planned the same way as a built-in one.
//
// Shape of a pipeline the split takes:
//   - optional MiTool steps first, starting with `mitool-parse`;
//   - then `align`;
//   - then any of refineTagsAndSort, assemblePartial, extend, assemble, assembleContigs,
//     assembleCells, in an order whose file types chain;
//   - exportClones and exportCloneGroups anywhere after `align`. They are dropped: the block
//     saves nothing from them, and they read a file without changing it.
//
// The last step must write a .clns, and `assemble` must be present.

text := import("text")

// The file the last step writes.
CLNS_FILE_NAME := "result.clns"

_EXPORT_STEPS := { exportClones: true, exportCloneGroups: true }

// Input and output file type of each chain step. "same" keeps the input's type.
_CHAIN_STEPS := {
	refineTagsAndSort: { from: ["vdjca"], out: "vdjca" },
	assemblePartial: { from: ["vdjca"], out: "vdjca" },
	extend: { from: ["vdjca", "clns"], out: "same" },
	assemble: { from: ["vdjca"], out: "assemble" },
	assembleContigs: { from: ["clna"], out: "clns" },
	assembleCells: { from: ["clns"], out: "clns" }
}

_MITOOL_COMMANDS := {
	"mitool-parse": "parse",
	"mitool-refine-tags": "refine-tags",
	"mitool-consensus": "consensus"
}

_contains := func(list, value) {
	for v in list {
		if v == value {
			return true
		}
	}
	return false
}

// hasCellTag reports whether the resolved preset's tag pattern captures a cell barcode (CELL,
// CELL1, CELL2, ...). `mixcr exportPreset` applies the user's --tag-pattern before writing the
// bundle, so `align.tagPattern` is the pattern the run aligns with.
hasCellTag := func(presetContent) {
	if !is_map(presetContent) || !is_map(presetContent.align) {
		return false
	}
	tagPattern := presetContent.align.tagPattern
	if !is_string(tagPattern) {
		return false
	}
	return text.contains(tagPattern, "(CELL")
}

// hasLongReadAligner reports whether the resolved preset aligns with the long-read aligner:
// only presets built on `align-long-read` carry `align.parameters.longReadsParameters`.
hasLongReadAligner := func(presetContent) {
	if !is_map(presetContent) || !is_map(presetContent.align) || !is_map(presetContent.align.parameters) {
		return false
	}
	return is_map(presetContent.align.parameters.longReadsParameters)
}

// _mitoolSteps lists the MiTool commands in run order: [{ command, logKey, outName, grant }].
// Each `consensus` round is its own command. 'undefined' when the MiTool part is malformed.
_mitoolSteps := func(presetContent, names) {
	steps := []
	for i, name in names {
		command := _MITOOL_COMMANDS[name]
		if is_undefined(command) || (i == 0) != (name == "mitool-parse") {
			return undefined
		}
		if command != "consensus" {
			grant := command == "parse" ? "mitoolParse" : "mitoolStep"
			steps = append(steps, { command: command, logKey: name, outName: command + ".mic", grant: grant })
			continue
		}
		rounds := is_map(presetContent.mitool) ? presetContent.mitool.consensus : undefined
		if !is_array(rounds) || len(rounds) == 0 {
			return undefined
		}
		for r := 1; r <= len(rounds); r++ {
			steps = append(steps, {
				command: command,
				logKey: name + "." + string(r),
				outName: command + "." + string(r) + ".mic",
				grant: "mitoolStep"
			})
		}
	}
	return steps
}

// _assembleGrant names the grant `assemble` takes. Only the plain bulk run, where `assemble`
// reads the untagged .vdjca `align` wrote, is sized from the align report's clone estimate.
_assembleGrant := func(presetContent, mitool, chainSteps) {
	if hasLongReadAligner(presetContent) {
		return "longReadAssemble"
	}
	if hasCellTag(presetContent) || _contains(chainSteps, "assembleCells") {
		return "cellAssemble"
	}
	if _contains(chainSteps, "refineTagsAndSort") {
		return "umiAssemble"
	}
	if len(mitool) == 0 && len(chainSteps) == 1 && chainSteps[0] == "assemble" {
		return "bulkAssemble"
	}
	return "untaggedAssemble"
}

// plan returns { mitool: [...], align: { logKey }, chain: [{ step, logKey, outName, grant }],
// qc: { logKey } }, or 'undefined'.
plan := func(presetContent) {
	if !is_map(presetContent) || !is_array(presetContent.pipeline) {
		return undefined
	}
	pipeline := presetContent.pipeline

	alignAt := -1
	for i, step in pipeline {
		if step == "align" {
			alignAt = i
			break
		}
	}
	if alignAt < 0 {
		return undefined
	}

	mitool := _mitoolSteps(presetContent, pipeline[:alignAt])
	if is_undefined(mitool) {
		return undefined
	}

	chainSteps := []
	for step in pipeline[alignAt + 1:] {
		if !_EXPORT_STEPS[step] {
			chainSteps = append(chainSteps, step)
		}
	}

	assemblePartialRounds := 1
	if is_map(presetContent.assemblePartial) {
		repeats := int(presetContent.assemblePartial.repeats)
		if !is_undefined(repeats) && repeats > 1 {
			assemblePartialRounds = repeats
		}
	}
	clnaOutput := is_map(presetContent.assemble) && presetContent.assemble.clnaOutput == true
	assembleGrant := _assembleGrant(presetContent, mitool, chainSteps)

	links := []
	kind := "vdjca"
	hasAssemble := false
	for step in chainSteps {
		def := _CHAIN_STEPS[step]
		if is_undefined(def) || !_contains(def.from, kind) {
			return undefined
		}
		if def.out == "assemble" {
			kind = clnaOutput ? "clna" : "clns"
			hasAssemble = true
		} else if def.out != "same" {
			kind = def.out
		}

		grant := "cellStep"
		if step == "assemble" {
			grant = assembleGrant
		} else if step == "refineTagsAndSort" {
			grant = "refineTagsAndSort"
		}

		rounds := step == "assemblePartial" ? assemblePartialRounds : 1
		for r := 1; r <= rounds; r++ {
			suffix := rounds > 1 ? "." + string(r) : ""
			links = append(links, {
				step: step,
				logKey: step + suffix,
				outName: step + suffix + "." + kind,
				grant: grant
			})
		}
	}
	if !hasAssemble || kind != "clns" {
		return undefined
	}
	last := links[len(links) - 1]
	last.outName = CLNS_FILE_NAME

	// Log keys lead with the run position, zero-padded, so the step that has got furthest sorts
	// last and the UI needs no list of steps.
	align := { logKey: "align" }
	qc := { logKey: "qc" }
	position := 0
	for step in append(append(append(mitool, align), links...), qc) {
		position++
		step.logKey = (position < 10 ? "0" : "") + string(position) + ":" + step.logKey
	}

	return { mitool: mitool, align: align, chain: links, qc: qc }
}

export {
	plan: plan,
	hasCellTag: hasCellTag,
	hasLongReadAligner: hasLongReadAligner
}
