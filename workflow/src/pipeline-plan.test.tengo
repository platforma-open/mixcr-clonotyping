test := import("@platforma-sdk/workflow-tengo:test")
pp := import(":pipeline-plan")
text := import("text")

// Every preset the split takes carries qc checks.
_withQc := func(preset) {
	if is_map(preset) && is_undefined(preset.qc) {
		preset.qc = { checks: [{}] }
	}
	return preset
}

_plan := func(preset) { return pp.plan(_withQc(preset)) }

_steps := func(plan) {
	out := []
	for link in plan.chain {
		out = append(out, text.split(link.logKey, ":")[1] + ">" + link.outName)
	}
	return out
}

_mitool := func(plan) {
	out := []
	for step in plan.mitool {
		out = append(out, step.command + ">" + step.outName)
	}
	return out
}

TestTenXMiToolPipelineSplitsEveryStep := func() {
	preset := {
		pipeline: ["mitool-parse", "mitool-refine-tags", "mitool-consensus", "align", "refineTagsAndSort",
			"extend", "assemble", "assembleContigs", "assembleCells", "exportClones", "exportCloneGroups"],
		mitool: { consensus: [{}, {}, {}, {}] },
		assemble: { clnaOutput: true }
	}
	plan := _plan(preset)
	test.isEqual(["parse>parse.mic", "refine-tags>refine-tags.mic", "consensus>consensus.1.mic",
		"consensus>consensus.2.mic", "consensus>consensus.3.mic", "consensus>consensus.4.mic"], _mitool(plan))
	test.isEqual("06:mitool-consensus.4", plan.mitool[5].logKey)
	test.isEqual("07:align", plan.align.logKey)
	test.isEqual("12:assembleCells", plan.chain[4].logKey)
	test.isEqual("13:qc", plan.qc.logKey)
	test.isEqual(["refineTagsAndSort>refineTagsAndSort.vdjca", "extend>extend.vdjca",
		"assemble>assemble.clna", "assembleContigs>assembleContigs.clns",
		"assembleCells>result.clns"], _steps(plan))
}

TestUmiPipelineHasNoMiToolSteps := func() {
	plan := _plan({ pipeline: ["align", "refineTagsAndSort", "assemble", "exportClones"] })
	test.isEqual([], plan.mitool)
	test.isEqual(["01:align", "02:refineTagsAndSort", "03:assemble", "04:qc"],
		[plan.align.logKey, plan.chain[0].logKey, plan.chain[1].logKey, plan.qc.logKey])
	test.isEqual(["refineTagsAndSort>refineTagsAndSort.vdjca", "assemble>result.clns"], _steps(plan))
}

TestAssemblePartialRepeatsAreRounds := func() {
	preset := {
		pipeline: ["align", "assemblePartial", "extend", "assemble", "assembleContigs", "exportClones"],
		assemblePartial: { repeats: 2 },
		assemble: { clnaOutput: true }
	}
	test.isEqual(["assemblePartial.1>assemblePartial.1.vdjca", "assemblePartial.2>assemblePartial.2.vdjca",
		"extend>extend.vdjca", "assemble>assemble.clna", "assembleContigs>result.clns"],
		_steps(_plan(preset)))
}

TestExportsBeforeTheLastStepAreDropped := func() {
	// 10x-5gex-full-length runs assembleCells after the exports.
	preset := {
		pipeline: ["align", "refineTagsAndSort", "assemblePartial", "extend", "assemble", "assembleContigs",
			"exportClones", "exportCloneGroups", "assembleCells"],
		assemble: { clnaOutput: true }
	}
	steps := _steps(_plan(preset))
	test.isEqual(6, len(steps))
	test.isEqual("assembleCells>result.clns", steps[5])
}

TestUnknownStepFallsBackToAnalyze := func() {
	test.isTrue(is_undefined(_plan({ pipeline: ["align", "assemble", "findAlleles", "exportClones"] })))
	test.isTrue(is_undefined(_plan({ pipeline: ["mitool-parse", "mitool-slice", "align", "assemble"], mitool: {} })))
}

TestMalformedPipelinesFallBackToAnalyze := func() {
	// No align.
	test.isTrue(is_undefined(_plan({ pipeline: ["assemble", "exportClones"] })))
	// No assemble.
	test.isTrue(is_undefined(_plan({ pipeline: ["align", "refineTagsAndSort", "exportClones"] })))
	// MiTool not starting with parse.
	test.isTrue(is_undefined(_plan({ pipeline: ["mitool-consensus", "align", "assemble"], mitool: { consensus: [{}] } })))
	// MiTool consensus with no rounds.
	test.isTrue(is_undefined(_plan({ pipeline: ["mitool-parse", "mitool-consensus", "align", "assemble"], mitool: { consensus: [] } })))
	// assembleContigs needs a .clna.
	test.isTrue(is_undefined(_plan({ pipeline: ["align", "assemble", "assembleContigs"], assemble: { clnaOutput: false } })))
	// The last step must write a .clns.
	test.isTrue(is_undefined(_plan({ pipeline: ["align", "assemble"], assemble: { clnaOutput: true } })))
	test.isTrue(is_undefined(_plan(undefined)))
}

TestStepClass := func() {
	test.isEqual("longRead", pp.stepClass({ pipeline: ["align", "assemble"],
		align: { parameters: { longReadsParameters: {} } } }))
	test.isEqual("cell", pp.stepClass({ pipeline: ["align", "refineTagsAndSort", "assemble"],
		align: { tagPattern: "^(CELL:N{16})(UMI:N{10})\\^(R2:*)" } }))
	test.isEqual("cell", pp.stepClass({ pipeline: ["align", "refineTagsAndSort", "assemble", "assembleCells"],
		align: { tagPattern: "^(UMI:N{10})\\^(R2:*)" } }))
	test.isEqual("umi", pp.stepClass({ pipeline: ["align", "refineTagsAndSort", "assemble"],
		align: { tagPattern: "^(UMI:N{10})\\^(R2:*)" } }))
	test.isEqual("none", pp.stepClass({ pipeline: ["align", "assemblePartial", "extend", "assemble"], align: {} }))
}

TestEveryStepNamesItsResourcesRow := func() {
	preset := {
		pipeline: ["mitool-parse", "mitool-consensus", "align", "refineTagsAndSort", "extend", "assemble"],
		mitool: { consensus: [{}, {}] }
	}
	plan := _plan(preset)
	test.isEqual(["mitool-parse", "mitool-consensus", "mitool-consensus"],
		[plan.mitool[0].step, plan.mitool[1].step, plan.mitool[2].step])
	test.isEqual(["align", "refineTagsAndSort", "extend", "assemble", "qc"],
		[plan.align.step, plan.chain[0].step, plan.chain[1].step, plan.chain[2].step, plan.qc.step])
	test.isEqual("umi", plan.class)
}

TestHasCellTag := func() {
	_withPattern := func(p) { return { align: { tagPattern: p } } }
	test.isTrue(pp.hasCellTag(_withPattern("^(CELL1:N{9})aatg(CELL2:N{9})ccac(CELL3:N{9})(UMI:N{8})\\^(R2:*)")))
	test.isTrue(pp.hasCellTag(_withPattern("^(CELL:N{16})(UMI:N{12})\\^(R2:*)")))
	test.isFalse(pp.hasCellTag(_withPattern("^N{0:2}(UMI:N{12})\\^(R2:*)")))
	test.isFalse(pp.hasCellTag(_withPattern("^(R1:*)\\^(R2:*)")))
	test.isFalse(pp.hasCellTag({ align: {} }))
	test.isFalse(pp.hasCellTag({}))
	test.isFalse(pp.hasCellTag(undefined))
}

TestHasLongReadAligner := func() {
	test.isTrue(pp.hasLongReadAligner({ align: { parameters: { longReadsParameters: { windowSize: 1500 } } } }))
	test.isFalse(pp.hasLongReadAligner({ align: { parameters: { vParameters: {} } } }))
	test.isFalse(pp.hasLongReadAligner({ align: { parameters: { longReadsParameters: undefined } } }))
	test.isFalse(pp.hasLongReadAligner({ align: {} }))
	test.isFalse(pp.hasLongReadAligner(undefined))
}

TestStepsRunInMiXCROrderWhateverTheListOrder := func() {
	preset := {
		pipeline: ["exportClones", "assembleContigs", "assemble", "extend", "align", "refineTagsAndSort"],
		assemble: { clnaOutput: true }
	}
	test.isEqual(["refineTagsAndSort>refineTagsAndSort.vdjca", "extend>extend.vdjca",
		"assemble>assemble.clna", "assembleContigs>result.clns"], _steps(_plan(preset)))
	test.isEqual("01:align", _plan(preset).align.logKey)
}

TestRunsWithoutQcChecksFallBackToAnalyze := func() {
	test.isTrue(is_undefined(pp.plan({ pipeline: ["align", "assemble"], qc: { checks: [] } })))
	test.isTrue(is_undefined(pp.plan({ pipeline: ["align", "assemble"] })))
	test.isFalse(is_undefined(_plan({ pipeline: ["align", "assemble"] })))
}

TestSampleSplittingRunsFallBackToAnalyze := func() {
	miltenyi := { pipeline: ["align", "refineTagsAndSort", "assemble"],
		align: { splitBySample: true, tagPattern: "^N{0:12}tggtatcaacgcagagt(SMPL:N{5})(UMI:N{14})N{21}(R1:)\\^N{20}(R2:)" } }
	test.isTrue(pp.splitsBySample(miltenyi))
	test.isTrue(is_undefined(_plan(miltenyi)))
	// splitBySample off, or no sample tag: no split.
	test.isFalse(pp.splitsBySample({ align: { splitBySample: false, tagPattern: "^(SMPL:N{5})(R1:*)" } }))
	test.isFalse(pp.splitsBySample({ align: { splitBySample: true, tagPattern: "^(R1F:N{0:2}(C:ggg)(R1:*))\\^(R2F:(UMI:NNNN)(R2:*))" } }))
	// A MiTool parse pattern with a sample tag splits too.
	test.isTrue(pp.splitsBySample({ mitool: { parse: { splitBySample: true, pattern: "^(CELL:N{16})(SAMPLE:N{8})\\^(R2:*)" } } }))
}
