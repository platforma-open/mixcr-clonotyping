// Runs the commands of a step plan, one exec per step, each with its CPU and memory from
// :resources. :run-steps runs a plan up to the first step sized from the align report;
// :run-steps-after-align runs the rest once that report is ready.

times := import("times")
ll := import("@platforma-sdk/workflow-tengo:ll")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
mixcrCmd := import(":mixcr-cmd")
resources := import(":resources")

CACHE_PERIOD := 48 * times.hour
// For the steps that write no final output (the clones or the qc result).
INTERMEDIATE_CACHE_PERIOD := 36 * times.hour

// run runs plan.commands from index `from`. ctx is { sw, files, readNames, stepClass, features,
// res, written, logs, alignReport }: `files` holds the block files by name, `written` and `logs`
// gain the files each step writes (by name) and its stdout stream (by logKey), and `alignReport`
// is the parsed align report, undefined until it is ready.
//
// Without ctx.alignReport, run stops before the first step sized from the align report and
// returns { stopAt, alignReport }: that step's index and the report's content resource. It
// returns {} when it ran every step.
run := func(plan, from, ctx) {
	needsReport := false
	for i, c in plan.commands {
		if i >= from && resources.sizedByReport(c.key, ctx.stepClass, ctx.features, ctx.res) {
			needsReport = true
		}
	}
	needsReport = needsReport && is_undefined(ctx.alignReport)

	reportContent := undefined
	for i, c in plan.commands {
		if i < from {
			continue
		}
		sized := resources.sizedByReport(c.key, ctx.stepClass, ctx.features, ctx.res)
		if sized && !is_undefined(reportContent) {
			return { stopAt: i, alignReport: reportContent }
		}

		// The name is the job's label on the backend (the k8s job name, the failure message).
		cmd := mixcrCmd.builder(ctx.sw).name("mixcr " + c.key).arg(c.args[0])
		if c.key == "align" {
			// `--threads` reads the granted count back from the placeholder, so the flag and the
			// request cannot diverge. `analyze` prints it only when it is given one.
			cmd.arg("--threads").argExpr("{system.cpu}")
		}
		for arg in c.args[1:] {
			cmd.arg(arg)
		}
		// The files the step is sized from.
		for name in c.stageSteps {
			cmd.addFile(name, ctx.written[name], { tag: resources.INPUT_TAG })
		}
		if c.stageReads {
			for name in ctx.readNames {
				cmd.addFile(name, ctx.files[name], { tag: resources.INPUT_TAG })
			}
		}
		for name in c.stageBlock {
			cmd.addFile(name, ctx.files[name])
		}
		for name in c.save {
			cmd.saveFile(name)
		}
		reportName := needsReport && c.key == "align" ? c.jsonReport : undefined
		if !is_undefined(reportName) {
			cmd.saveFileContent(reportName)
		}

		fixedRam := undefined
		if sized && !is_undefined(ctx.alignReport) {
			fixedRam = resources.ramFromReport(resources.cloneRow(c.key, ctx.stepClass, ctx.features), ctx.alignReport)
			if is_undefined(fixedRam) {
				ll.print("the align report has no clone estimate; %v is sized from its input", c.key)
			}
		}
		resources.apply(cmd, resources.lookup(c.key, ctx.stepClass), ctx.res, fixedRam)
		cachePeriod := c.writesFinalOutput ? CACHE_PERIOD : INTERMEDIATE_CACHE_PERIOD
		r := cmd.cache(cachePeriod).run()
		ctx.logs[c.logKey] = r.getStdoutStream()
		for name in c.save {
			ctx.written[name] = r.getFile(name)
		}
		if !is_undefined(reportName) {
			reportContent = r.getFileContent(reportName)
		}
	}
	return {}
}

// outputs returns the outputs of a run: the qc result, the reports p-column (the ids :process
// lists, under the names `analyze` gives them), the step logs and the clones.
outputs := func(plan, written, logs, reports) {
	reportsMap := pcolumn.resourceMapBuilder( /* keyLength */ 2 )
	for report in reports {
		for name in [report.fileJson, report.fileTxt] {
			ll.assert(!is_undefined(written[name]), "no MiXCR step writes the %v report %v", report.id, name)
		}
		reportsMap.add([report.id, "json"], written[report.fileJson])
		reportsMap.add([report.id, "txt"], written[report.fileTxt])
	}
	// One stream per step, keyed by its run position and name (`007:align`). Carried as the
	// sample's `log` output: a run from before the split holds a single stream there instead.
	stepLogs := pcolumn.resourceMapBuilder( /* keyLength */ 1 )
	for logKey, stream in logs {
		stepLogs.add([logKey], stream)
	}
	return {
		qc: written[plan.qcJson],
		log: stepLogs.build(),
		reports: reportsMap.build(),
		clns: written[plan.clns]
	}
}

export {
	run: run,
	outputs: outputs
}
